    <RootNamespace>DiscrepancyScanner</RootNamespace>
    <AssemblyName>DiscrepancyScanner</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <NuGetPackageImportStamp>
    </NuGetPackageImportStamp>
    <!--
      The XAML markup compiler normally runs in its own AppDomain, which has no binding
      redirects and so fails to load the netstandard facades this project pulls in through
      System.Text.Json. Running it in the build's own AppDomain picks up the redirects.
    -->
    <AlwaysCompileMarkupFilesInSeparateDomain>false</AlwaysCompileMarkupFilesInSeparateDomain>
  </PropertyGroup>
  <!--
    Where the Revit and ETABS SDK assemblies live. They are not redistributable, so they are
    referenced from the local product install rather than checked in. Override on the command
    line to build against a different install, e.g.
      msbuild /p:RevitVersion=2024 /p:EtabsVersion=22
    or point at a directory directly with /p:RevitApiDir=... /p:EtabsApiDir=...
  -->
  <PropertyGroup>
    <RevitVersion Condition=" '$(RevitVersion)' == '' ">2025</RevitVersion>
    <EtabsVersion Condition=" '$(EtabsVersion)' == '' ">22</EtabsVersion>
    <SafeVersion Condition=" '$(SafeVersion)' == '' ">22</SafeVersion>
    <ProgramFilesRoot Condition=" '$(ProgramFilesRoot)' == '' ">$(ProgramW6432)</ProgramFilesRoot>
    <ProgramFilesRoot Condition=" '$(ProgramFilesRoot)' == '' ">$(ProgramFiles)</ProgramFilesRoot>
    <RevitApiDir Condition=" '$(RevitApiDir)' == '' ">$(ProgramFilesRoot)\Autodesk\Revit $(RevitVersion)</RevitApiDir>
    <EtabsApiDir Condition=" '$(EtabsApiDir)' == '' ">$(ProgramFilesRoot)\Computers and Structures\ETABS $(EtabsVersion)</EtabsApiDir>
    <SafeApiDir Condition=" '$(SafeApiDir)' == '' ">$(ProgramFilesRoot)\Computers and Structures\SAFE $(SafeVersion)</SafeApiDir>
    <!--
      CSiAPIv1.dll is the assembly CSI ships with every one of its products, and the ETABS and
      SAFE copies are the same interfaces: identical COM interface GUIDs, identical method
      signatures, identical enum names and values. That is what lets a single build drive both
      programs. Either copy will do, so take whichever product is installed - ETABS first,
      because that is the one every existing user of this add-in already has.
    -->
    <CsiApiDir Condition=" '$(CsiApiDir)' == '' And Exists('$(EtabsApiDir)\CSiAPIv1.dll') ">$(EtabsApiDir)</CsiApiDir>
    <CsiApiDir Condition=" '$(CsiApiDir)' == '' ">$(SafeApiDir)</CsiApiDir>
  </PropertyGroup>
