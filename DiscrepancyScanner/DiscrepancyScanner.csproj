  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Import Project="..\packages\System.ValueTuple.4.6.1\build\net471\System.ValueTuple.targets" Condition="Exists('..\packages\System.ValueTuple.4.6.1\build\net471\System.ValueTuple.targets')" />
  <!--
    Writes down where this build put the add-in, for AddinAssemblies to read back at runtime.

    Revit, loading the add-in from a .addin manifest, finds CSiAPIv1.dll and EtabsTextModel.dll
    beside it in this same folder and none of this matters. The Add-in Manager copies
    DiscrepancyScanner.dll on its own into a temporary folder and loads that, and from there
    the only way back to the two DLLs is to have written down where they were left.
  -->
  <!--
    Carries CSiAPIv1.dll and EtabsTextModel.dll inside DiscrepancyScanner.dll as well as beside
    it, for AddinAssemblies to load from bytes when the Add-in Manager's lone copy cannot reach
    the files - or reaches them and is refused, because another copy of the add-in loaded in
    the same Revit session already holds them. Taken from the resolved references, so it is
    always the exact files this build was compiled against.
  -->
  <Target Name="EmbedAddinManagerDependencies" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <EmbeddedResource Include="@(ReferencePath)" Condition="'%(Filename)' == 'CSiAPIv1' Or '%(Filename)' == 'EtabsTextModel'">
        <LogicalName>DiscrepancyScanner.Embedded.%(Filename)%(Extension)</LogicalName>
        <WithCulture>false</WithCulture>
        <Type>Non-Resx</Type>
      </EmbeddedResource>
    </ItemGroup>
  </Target>
  <Target Name="RecordBuildFolder" BeforeTargets="BeforeCompile">
    <PropertyGroup>
      <AddinBuildFolder>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(OutputPath)'))</AddinBuildFolder>
      <AddinBuildFolderSource>$(IntermediateOutputPath)AddinBuildFolder.g.cs</AddinBuildFolderSource>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(AddinBuildFolderSource)" Overwrite="true" WriteOnlyWhenDifferent="true" Lines="namespace DiscrepancyScanner { internal static class AddinBuildFolder { internal const string Path = @&quot;$(AddinBuildFolder)&quot;%3B } }" />
    <ItemGroup>
      <Compile Include="$(AddinBuildFolderSource)" />
      <FileWrites Include="$(AddinBuildFolderSource)" />
    </ItemGroup>
  </Target>
  <!--
    Gives every build a version of its own - 1.0.yyDDD.(seconds since midnight / 2) - and
    names it in the windows' pack URIs.

    The Add-in Manager loads a fresh copy of the DLL each time it is rebuilt, and the copies
    before it stay loaded until Revit closes. A window finds its XAML by a pack URI, which
    names the assembly by its short name alone, and with two copies loaded that can find the
    other copy's XAML - which WPF refuses with "The component ... does not have a resource
    identified by the URI". Set here, the markup compiler writes the version into every
    window's URI (/DiscrepancyScanner;V1.0.26265.1234;component/...), and each copy finds
    its own.
  -->
  <Target Name="StampBuildVersion" BeforeTargets="MarkupCompilePass1;BeforeCompile">
    <PropertyGroup>
      <_BuildDay>$([MSBuild]::Add($([MSBuild]::Multiply($([System.DateTime]::Now.ToString('yy')), 1000)), $([System.DateTime]::Now.DayOfYear)))</_BuildDay>
      <_BuildTime>$([System.Math]::Floor($([MSBuild]::Divide($([System.DateTime]::Now.TimeOfDay.TotalSeconds), 2))))</_BuildTime>
      <AssemblyVersion>1.0.$(_BuildDay).$(_BuildTime)</AssemblyVersion>
      <BuildVersionSource>$(IntermediateOutputPath)BuildVersion.g.cs</BuildVersionSource>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(BuildVersionSource)" Overwrite="true" Lines="[assembly: System.Reflection.AssemblyVersion(&quot;$(AssemblyVersion)&quot;)]" />
    <ItemGroup>
      <Compile Include="$(BuildVersionSource)" />
      <FileWrites Include="$(BuildVersionSource)" />
    </ItemGroup>
  </Target>
  <!--
    The Revit 2025 API assemblies are built against .NET 8 and reference netstandard 2.1.
    The C# compiler copes with that, but the legacy XAML markup compiler reflection-loads
    the whole reference closure in a .NET Framework AppDomain and fails with MC1000. The XAML
    never touches the Revit API, so the reference is taken out of the markup compiler's view
    and put straight back for the actual compile.
  -->
  <Target Name="HideRevitApiFromMarkupCompiler" BeforeTargets="MarkupCompilePass1">
    <ItemGroup>
      <_RevitApiReferenceStash Include="@(ReferencePath)" Condition="'%(FileName)' == 'RevitAPI' Or '%(FileName)' == 'RevitAPIUI'" />
      <ReferencePath Remove="@(_RevitApiReferenceStash)" />
    </ItemGroup>
  </Target>
  <Target Name="RestoreRevitApiAfterMarkupCompiler" AfterTargets="MarkupCompilePass1">
    <ItemGroup>
      <ReferencePath Include="@(_RevitApiReferenceStash)" />
    </ItemGroup>
  </Target>
