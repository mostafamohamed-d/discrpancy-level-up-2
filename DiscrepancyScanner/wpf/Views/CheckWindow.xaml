<Window x:Class="DiscrepancyScanner.Wpf.CheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ETABS / Revit model check"
        Height="800" Width="1300" MinHeight="520" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ColorBg}"
        WindowStyle="None" ResizeMode="CanResize">

    <!--
        No native title bar: the header below already names the tool and carries the actions,
        and a Windows caption above it would be a second, emptier one saying the same thing.

        WindowChrome rather than a bare WindowStyle="None" so everything the frame was doing
        for free still works - the resize edges, snapping, double-click to maximise, and the
        system menu on right-click. CaptionHeight is what makes the header draggable; the
        buttons in it opt out with shell:WindowChrome.IsHitTestVisibleInChrome.
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Theme/Industry.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="ShowWhenTrue" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF555555" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <!--
            A button in the plan header that holds a panel behind it. The panels it holds -
            which results are on show, and which of them are stamped on the drawing - belong to
            the drawing rather than to the window, so they are reached from the band above it
            rather than from a column down the side that was open whether or not it was wanted.

            Pressed in while its panel is open, so the button reads as the panel's own edge.
        -->
        <Style x:Key="HeaderToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome" Background="Transparent" Padding="12,5"
                                BorderBrush="{StaticResource ColorBorder}" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{StaticResource TintHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{StaticResource ColorSurface}" />
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{StaticResource ColorBorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderToggleText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontHeading}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource ColorText}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--
            The icons on the plan's header buttons: line drawings on a 24 unit square, stroked
            in the text colour so they sit with the word beside them rather than above it.
            Drawn as paths rather than taken from an icon font, which would look different on
            every Windows release and not at all where the font is missing.
        -->
        <Style x:Key="HeaderIcon" TargetType="Path">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="{StaticResource ColorText}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- an eye: what is on show -->
        <Geometry x:Key="IconShow">M1,12 C4,6.5 7.8,4.5 12,4.5 C16.2,4.5 20,6.5 23,12 C20,17.5 16.2,19.5 12,19.5 C7.8,19.5 4,17.5 1,12 Z M15.3,12 A3.3,3.3 0 1 1 8.7,12 A3.3,3.3 0 1 1 15.3,12 Z</Geometry>

        <!-- a tag: what is written on the elements -->
        <Geometry x:Key="IconLabel">M2.5,3.5 L2.5,11 L13,21.5 L21.5,13 L11,2.5 L3.5,2.5 Z M9,7.5 A1.5,1.5 0 1 1 6,7.5 A1.5,1.5 0 1 1 9,7.5 Z</Geometry>

        <!-- a ruler laid across, with its marks -->
        <Geometry x:Key="IconMeasure">M2,16.5 L16.5,2 L22,7.5 L7.5,22 Z M6.5,12 L9,14.5 M9.5,9 L11,10.5 M12.5,6 L15,8.5</Geometry>

        <!-- four corners closing on the drawing -->
        <Geometry x:Key="IconZoomToFit">M3,8.5 L3,3 L8.5,3 M15.5,3 L21,3 L21,8.5 M21,15.5 L21,21 L15.5,21 M8.5,21 L3,21 L3,15.5 M8,8 L16,8 L16,16 L8,16 Z</Geometry>

        <!-- the sheet a header button drops: same ground and border as the window -->
        <Style x:Key="FlyoutPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ColorBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource ColorBorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect" Value="{StaticResource ShadowMd}" />
        </Style>

        <Style x:Key="FlyoutHeading" TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>

        <!--
            The header: which two models are loaded, when they were last checked, and the run
            itself. It is up here rather than down the side because the question it answers -
            "am I looking at the model I think I am?" - has to be answerable before a run, not
            found afterwards in the status line.
        -->
        <Border DockPanel.Dock="Top" Height="56" Background="{StaticResource ColorBg}"
                BorderBrush="{StaticResource ColorBorder}" BorderThickness="0,0,0,1">
            <DockPanel Margin="20,0">

                <!--
                    The mark: two models laid over each other, drawn in the same line as the
                    icons on the plan's buttons, with the ground they share - the part the tool
                    looks at - filled in the accent.
                -->
                <Viewbox DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,11,0"
                         VerticalAlignment="Center" SnapsToDevicePixels="True">
                    <Canvas Width="24" Height="24">
                        <Rectangle Canvas.Left="9" Canvas.Top="9" Width="6" Height="6"
                                   Fill="{StaticResource ColorAccent}" />
                        <Path Data="M2.5,2.5 L15,2.5 L15,15 L2.5,15 Z M9,9 L21.5,9 L21.5,21.5 L9,21.5 Z"
                              Stroke="{StaticResource ColorText}" StrokeThickness="1.8"
                              StrokeLineJoin="Round" />
                    </Canvas>
                </Viewbox>

                <TextBlock DockPanel.Dock="Left" Text="DISCREPANCY SCANNER"
                           Style="{StaticResource BrandText}" VerticalAlignment="Center" />

                <Rectangle DockPanel.Dock="Left" Width="1" Height="24" Margin="20,0"
                           Fill="{StaticResource ColorBorder}" VerticalAlignment="Center" />

                <!--
                    The window controls, taking the place of the caption buttons the frame used
                    to draw. The middle one is a toggle: its glyph and its tooltip both follow
                    the window state, so it reads as restore once the window is maximised.
                -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="14,0,-12,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="&#x2013;" Click="OnMinimiseClick" Width="40" Height="30"
                            Style="{StaticResource GhostButton}" FontSize="15"
                            Foreground="{StaticResource ColorNeutral700}" ToolTip="Minimise" />
                    <Button x:Name="maximiseButton" Click="OnMaximiseClick" Width="40" Height="30"
                            Style="{StaticResource GhostButton}" FontSize="12"
                            Foreground="{StaticResource ColorNeutral700}"
                            Content="&#x25A1;" ToolTip="Maximise" />
                    <Button Content="&#x2715;" Click="OnCloseClick" Width="40" Height="30"
                            Style="{StaticResource GhostButton}" FontSize="13"
                            Foreground="{StaticResource ColorNeutral700}" ToolTip="Close" />
                </StackPanel>

                <!-- the run, hard right -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Models.LastRunDescription}" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="NoWrap" />
                    <Button Content="EXPORT" Style="{StaticResource SecondaryButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Command="{Binding ExportBeamMarksCommand}" Margin="0,0,10,0"
                            ToolTip="One row per beam: its ETABS name and label beside the Beam Reinf. Mark of the Revit beam it was paired with." />
                    <Button Content="ALIGN" Style="{StaticResource SecondaryButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Command="{Binding OpenAlignmentCommand}" Margin="0,0,10,0"
                            ToolTip="Line the Revit model up with the ETABS one. Opens beside this window, so a pair of matched points can be picked here on the plan or over in Revit." />
                    <Button Content="SET UP" Style="{StaticResource SecondaryButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Command="{Binding OpenSettingsCommand}" Margin="0,0,10,0"
                            ToolTip="{Binding SettingsLocation}" />
                    <Button Content="RE-CHECK LOADS" Style="{StaticResource SecondaryButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Command="{Binding RecheckLoadsCommand}" Margin="0,0,10,0"
                            Visibility="{Binding ShowsLoadRecheck, Converter={StaticResource ShowWhenTrue}}"
                            ToolTip="Reads the loading plans and schedules again and checks the slab and line loads only. Beams, columns, walls and slab thickness stay as the last run left them." />
                    <!-- the one solid object on the board, framed as the design has it -->
                    <!-- margin 8, not the style's 6: the marks sit 6px outside the frame and
                         the header is only 56 tall, so anything less clips them -->
                    <ContentControl Style="{StaticResource BlueprintCard}" Background="Transparent"
                                    BorderThickness="0" Margin="8" VerticalAlignment="Center">
                        <Button Content="RUN CHECK" Style="{StaticResource PrimaryButton}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Command="{Binding RunCheckCommand}" Padding="18,8"
                                ToolTip="Runs the checks that are switched on. Anything that would make the answer worth less than it looks is said first." />
                    </ContentControl>
                </StackPanel>

                <!-- the two models, in the order they are read. In the filling child, so a
                     narrow window trims a file name rather than running it under the run time. -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0"
                                ToolTip="Read the ETABS model from the running instance, or from a saved file.">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,7,0"
                                 Fill="{Binding Models.Etabs.Dot}" />
                        <TextBlock Text="{Binding Models.Etabs.Description}" Style="{StaticResource BodyText}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                ToolTip="Read the Revit model from the open document.">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,7,0"
                                 Fill="{Binding Models.Revit.Dot}" />
                        <TextBlock Text="{Binding Models.Revit.Description}" Style="{StaticResource BodyText}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>

                <Grid />
            </DockPanel>
        </Border>

        <!--
            The scope bar, across the top of everything: which checks are being read, and how
            much is open under each. The chips are not exclusive - several can be on at once,
            which is how a beam and the column it lands on are read together, and turning the
            rest off is how one kind is looked at on its own.

            The count is the point of putting them here. A chip reading "Walls 27" says where
            the work is before it is opened, which the switches down the side never could.
        -->
        <Border DockPanel.Dock="Top" Height="48" Background="{StaticResource ColorSurface}"
                BorderBrush="{StaticResource ColorDivider}" BorderThickness="0,0,0,1">
            <DockPanel Margin="20,0">

                <!-- the verdict key, right-aligned, in the colours the canvas draws -->

                <!--
                    One segmented block with a hairline round the outside, so the chips read as
                    one control rather than five buttons. A chip that is on takes the ink as its
                    ground, the way the design has it.
                -->
                <!--
                    The chips in their groups: Geometry, the checks on the elements themselves;
                    Loads, the checks on what they carry; and the height zones on their own.
                -->
                <ItemsControl ItemsSource="{Binding Findings.Groups}" VerticalAlignment="Center"
                              Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionLabel}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"
                                           Visibility="{Binding HasTitle, Converter={StaticResource ShowWhenTrue}}" />
                            <Border BorderBrush="{StaticResource ColorDivider}" BorderThickness="1"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                <ItemsControl ItemsSource="{Binding Tabs}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ToggleButton IsChecked="{Binding IsActive}" ToolTip="{Binding ToolTip}"
                                                          Cursor="Hand" Focusable="True">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border x:Name="Chip" Background="Transparent"
                                                                BorderBrush="{StaticResource ColorDivider}"
                                                                BorderThickness="1,0,0,0" Padding="12,6">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock x:Name="Label" Text="{Binding Label}"
                                                                           FontFamily="{StaticResource FontBody}"
                                                                           FontSize="13" VerticalAlignment="Center"
                                                                           Foreground="{StaticResource ColorNeutral700}" />
                                                                <!--
                                                                    The count only appears where there is
                                                                    something to count: a clean check reads
                                                                    as a bare name, not as a zero.
                                                                -->
                                                                <Border x:Name="Badge" Margin="7,0,0,0" Padding="4,0"
                                                                        Background="Transparent"
                                                                        BorderBrush="{StaticResource ColorBorder}"
                                                                        BorderThickness="1"
                                                                        VerticalAlignment="Center"
                                                                        Visibility="{Binding HasOpen, Converter={StaticResource ShowWhenTrue}}">
                                                                    <TextBlock x:Name="BadgeText" Text="{Binding Open}"
                                                                               Foreground="{StaticResource ColorNeutral700}"
                                                                               FontFamily="{StaticResource FontHeading}"
                                                                               FontWeight="SemiBold" FontSize="12" />
                                                                </Border>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <!--
                                                                A chip that is on takes the ink as its
                                                                ground and its count goes solid red; a chip
                                                                that is off keeps the count, but as a bare
                                                                outline - the number is still worth reading
                                                                on a check you are not looking at.
                                                            -->
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="Chip" Property="Background"
                                                                        Value="{StaticResource ColorText}" />
                                                                <Setter TargetName="Label" Property="Foreground"
                                                                        Value="{StaticResource ColorBg}" />
                                                                <Setter TargetName="Badge" Property="Background"
                                                                        Value="{DynamicResource VerdictFailed}" />
                                                                <Setter TargetName="Badge" Property="BorderThickness"
                                                                        Value="0" />
                                                                <Setter TargetName="Badge" Property="Padding"
                                                                        Value="5,0" />
                                                                <Setter TargetName="BadgeText" Property="Foreground"
                                                                        Value="White" />
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Chip" Property="Opacity" Value="0.85" />
                                                            </Trigger>
                                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                                <Setter TargetName="Chip" Property="BorderBrush"
                                                                        Value="{StaticResource ColorAccent}" />
                                                                <Setter TargetName="Chip" Property="BorderThickness" Value="2" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--
                    Both models as they were read, in place of what the check made of them. Beside
                    the tabs rather than behind SHOW because it changes what every tab draws, and
                    because it has to be seen to be on: a plan with nothing red on it reads as a
                    clean check unless the box saying why is in plain sight.
                -->
                <CheckBox IsChecked="{Binding ShowRawData}" Margin="14,0,0,0"
                          VerticalAlignment="Center" ToolTip="{Binding RawDataToolTip}">
                    <TextBlock Text="Raw data" FontFamily="{StaticResource FontBody}" FontSize="13"
                               Foreground="{StaticResource ColorNeutral700}" />
                </CheckBox>

                <!-- the filling child: the key sits at its right-hand end -->
                <Grid Margin="14,0,0,0">
                <ItemsControl ItemsSource="{Binding ShownVerdictKey}"
                              VerticalAlignment="Center" HorizontalAlignment="Right">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- right-click picks a new colour; the transparent background makes
                                 the gap between the swatch and its words part of the target -->
                            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" Background="Transparent"
                                        ToolTip="{Binding ToolTip}"
                                        MouseRightButtonUp="OnVerdictKeyRightClick">
                                <Rectangle Width="11" Height="11" Fill="{Binding Swatch}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Label}" Margin="6,0,0,0" FontSize="12"
                                           FontFamily="{StaticResource FontBody}"
                                           Foreground="{StaticResource ColorNeutral800}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </Grid>
            </DockPanel>
        </Border>

        <!--
            The findings drawer. Closed it is one line saying how much is left; open it is the
            worklist itself. It lists the level on show and only what is still switched on up
            top, so the drawer and the drawing are two readings of one set of results rather
            than two sets that can disagree.
        -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource ColorSurface}"
                BorderBrush="{StaticResource ColorBorder}" BorderThickness="0,1,0,0">
            <DockPanel>

                <Border DockPanel.Dock="Top" Padding="20,0" Height="44">
                    <DockPanel>
                        <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding FindingsList.IsOpen}"
                                      VerticalAlignment="Center" Cursor="Hand"
                                      ToolTip="Show every open finding on this level as a list.">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Chrome" Background="Transparent" Padding="12,6"
                                            BorderBrush="{StaticResource ColorBorder}" BorderThickness="1">
                                        <TextBlock x:Name="Text" Text="OPEN THE LIST"
                                                   FontFamily="{StaticResource FontHeading}"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{StaticResource ColorText}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chrome" Property="Background"
                                                    Value="{StaticResource ColorText}" />
                                            <Setter TargetName="Text" Property="Foreground"
                                                    Value="{StaticResource ColorBg}" />
                                            <Setter TargetName="Text" Property="Text" Value="CLOSE THE LIST" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="Opacity" Value="0.85" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="FINDINGS" Style="{StaticResource SectionLabel}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding FindingsList.OpenText}" Margin="14,0,0,0"
                                       Style="{StaticResource BodyText}" FontWeight="Bold"
                                       VerticalAlignment="Center" />
                            <Rectangle Width="1" Height="16" Margin="12,0" VerticalAlignment="Center"
                                       Fill="{StaticResource ColorBorder}" />
                            <TextBlock Text="{Binding FindingsList.Summary}" Style="{StaticResource BodyText}"
                                       Foreground="{StaticResource ColorNeutral700}" VerticalAlignment="Center" />

                            <!-- what moved since the last run, which the counts alone cannot say -->
                            <Rectangle Width="1" Height="16" Margin="12,0" VerticalAlignment="Center"
                                       Fill="{StaticResource ColorBorder}"
                                       Visibility="{Binding FindingsList.HasChanges,
                                           Converter={StaticResource ShowWhenTrue}}" />
                            <TextBlock Text="{Binding FindingsList.ChangeSummary}"
                                       Style="{StaticResource BodyText}"
                                       Foreground="{StaticResource ColorAccent700}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding FindingsList.HasChanges,
                                           Converter={StaticResource ShowWhenTrue}}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!--
                    Only up while something is ticked. An empty toolbar is a row of buttons that
                    do nothing, which teaches people not to look at it.
                -->
                <Border DockPanel.Dock="Bottom" Padding="20,8"
                        BorderBrush="{StaticResource ColorDivider}" BorderThickness="0,1,0,0"
                        Visibility="{Binding FindingsList.HasPicked,
                            Converter={StaticResource ShowWhenTrue}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding FindingsList.PickedText}"
                                   Style="{StaticResource BodyText}" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="0,0,14,0" />
                        <Button Content="MARK REVIEWED" Style="{StaticResource SecondaryButton}"
                                Command="{Binding MarkPickedReviewedCommand}"
                                ToolTip="Looked at, still open work. Each element is recorded against its own verdicts, so one that changes later asks for another look." />
                        <Button Content="ACCEPT" Style="{StaticResource SecondaryButton}"
                                Margin="8,0,0,0" Command="{Binding AcceptPickedCommand}"
                                ToolTip="Agreed differences. They stay on the plan and stop counting as open work." />
                        <Button Content="ADD A NOTE" Style="{StaticResource SecondaryButton}"
                                Margin="8,0,0,0" Command="{Binding AddNoteToPickedCommand}"
                                ToolTip="The same note on every ticked element." />
                    </StackPanel>
                </Border>

                <DataGrid ItemsSource="{Binding FindingsList.Rows}"
                          SelectedItem="{Binding FindingsList.SelectedRow, Mode=TwoWay}"
                          Visibility="{Binding FindingsList.IsOpen, Converter={StaticResource ShowWhenTrue}}"
                          Height="230" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0" CanUserResizeRows="False" BorderThickness="0"
                          Background="{StaticResource ColorBg}"
                          HorizontalGridLinesBrush="{StaticResource ColorDivider}"
                          FontFamily="{StaticResource FontBody}" FontSize="12"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <!-- the verdict colour, as a bar down the left of the row -->
                        <DataGridTemplateColumn Width="16">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Rectangle Width="9" Height="9" Fill="{Binding Swatch}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!--
                            Ticks rather than the grid's own selection: a DataGrid will not hand
                            its selected items to a view model, and ticking is what the design
                            does - it survives scrolling and reads as a worklist.
                        -->
                        <DataGridTemplateColumn Width="30">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsPicked, Mode=TwoWay,
                                                  UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- new since the last run, which is what a second run is read for -->
                        <DataGridTemplateColumn Header="New" Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding NewMark}" FontSize="10"
                                               FontFamily="{StaticResource FontHeading}"
                                               FontWeight="SemiBold" HorizontalAlignment="Center"
                                               Foreground="{StaticResource ColorAccent700}"
                                               ToolTip="Not in the last run." />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Element" Binding="{Binding ElementLabel}" Width="170" />
                        <DataGridTextColumn Header="Where" Binding="{Binding Where}" Width="90" />
                        <DataGridTextColumn Header="Check" Binding="{Binding CheckLabel}" Width="150" />
                        <DataGridTextColumn Header="What disagrees" Binding="{Binding Summary}" Width="*" />
                        <DataGridTextColumn Header="Sits with" Binding="{Binding Model}" Width="80" />

                        <!-- a tick for reviewed, a query for a review that has gone stale -->
                        <DataGridTemplateColumn Header="Seen" Width="46">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ReviewMark}" ToolTip="{Binding ReviewTip}"
                                               HorizontalAlignment="Center" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource VerdictPassed}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReviewStale}" Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource VerdictReview}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="150" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!--
            The status bar: what the window is doing now on the left, what the last run came to
            on the right. The recap used to sit in the panel down the side, where it was a
            paragraph nobody looked at twice; here it is one line beside the thing it recaps,
            and it stands down while a run is going so the progress has the strip to itself.
        -->
        <Border DockPanel.Dock="Bottom" Background="#FFE8E8E8" BorderBrush="#FFCCCCCC" BorderThickness="0,1,0,0">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right" Width="160" Height="12" Margin="6,6,10,6"
                             Minimum="0" Maximum="1" Value="{Binding CheckProgress, Mode=OneWay}"
                             Visibility="{Binding IsChecking, Converter={StaticResource ShowWhenTrue}}" />

                <!-- only up while there is a run to stop, which is the only time it means anything -->
                <Button DockPanel.Dock="Right" Content="{Binding StopButtonText}"
                        Style="{StaticResource SecondaryButton}" Padding="10,2" Margin="6,4"
                        Command="{Binding StopCheckCommand}"
                        Visibility="{Binding IsChecking, Converter={StaticResource ShowWhenTrue}}"
                        ToolTip="{Binding StopButtonHint}" />

                <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Margin="10,6"
                           MaxWidth="520" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource ColorNeutral700}"
                           ToolTip="{Binding Summary}"
                           Visibility="{Binding IsIdle, Converter={StaticResource ShowWhenTrue}}" />

                <TextBlock Text="{Binding Status}" Margin="10,6" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!--
            The level rail. The plan is one level at a time, so the question this answers is
            which level to go to next - which is why every row carries its own count rather
            than only the one on screen. A level with nothing open shows no bar at all.
        -->
        <Border DockPanel.Dock="Left" Width="150" Background="{StaticResource ColorBg}"
                BorderBrush="{StaticResource ColorDivider}" BorderThickness="0,0,1,0">
            <DockPanel>

                <Border DockPanel.Dock="Top" Padding="14,10,14,8"
                        BorderBrush="{StaticResource ColorDivider}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="LEVELS" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Binding Findings.Levels.Count}" Margin="8,0,0,0"
                                   Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- no bars to explain until something has been imported -->
                <TextBlock DockPanel.Dock="Bottom" Margin="14,8,14,10"
                           Text="Bars are open findings, to scale across the building."
                           Style="{StaticResource CaptionText}"
                           Visibility="{Binding HasStories, Converter={StaticResource ShowWhenTrue}}" />

                <!--
                    Selection goes through SelectedLevel, which is derived from the story on
                    screen - so clicking a row and stepping with the arrows above the plan are
                    the same act, and neither can leave the rail disagreeing with the drawing.
                -->
                <ListBox ItemsSource="{Binding Findings.Levels}"
                         SelectedItem="{Binding SelectedLevel, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row" Background="Transparent"
                                                BorderBrush="Transparent" BorderThickness="3,0,0,0"
                                                Padding="11,6,14,6">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background"
                                                        Value="{StaticResource TintHover}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="Background"
                                                        Value="{StaticResource ColorSurface}" />
                                                <Setter TargetName="Row" Property="BorderBrush"
                                                        Value="{StaticResource ColorAccent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="{Binding Elevation}" DockPanel.Dock="Right"
                                               Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource FontHeading}"
                                               FontWeight="SemiBold" FontSize="14"
                                               Foreground="{StaticResource ColorText}"
                                               TextTrimming="CharacterEllipsis" />
                                </DockPanel>

                                <!--
                                    Two bars, fails over the ones wanting a look, each as wide
                                    as its count. They are read against each other down the
                                    rail rather than measured, so the scale is shared: the
                                    worst level on the building fills the width.
                                -->
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                                            Visibility="{Binding HasFindings, Converter={StaticResource ShowWhenTrue}}">
                                    <Rectangle Height="3" Fill="{DynamicResource VerdictFailed}"
                                               Width="{Binding FailedBarWidth}" />
                                    <Rectangle Height="3" Fill="{DynamicResource VerdictReview}"
                                               Width="{Binding ReviewBarWidth}" Margin="1,0,0,0" />
                                </StackPanel>

                                <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionText}"
                                           Margin="0,3,0,0"
                                           Visibility="{Binding IsSelected, Converter={StaticResource ShowWhenTrue}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- centre: the model -->
        <Border BorderBrush="#FFDDDDDD" BorderThickness="1">
            <DockPanel>

                <!--
                    Which level the plan is showing, across the top of the drawing rather than
                    in the panel down the side. The plan is one level at a time and every
                    colour on it belongs to that level, so this is the one thing that has to be
                    readable without looking away from the model.
                -->
                <Border DockPanel.Dock="Top" Background="{StaticResource ColorBg}" Padding="14,8"
                        BorderBrush="{StaticResource ColorDivider}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Click="OnZoomToFitClick"
                                Style="{StaticResource SecondaryButton}"
                                Margin="12,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconZoomToFit}" Style="{StaticResource HeaderIcon}" />
                                <TextBlock Text="ZOOM TO FIT" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!--
                            Two clicks on the plan make a measurement, snapped to the ends,
                            corners, centres and crossings of either model. Stays down for the
                            next one until it is clicked again or right clicked off; what was
                            measured stays on the plan until an element is clicked or the plan
                            changes.
                        -->
                        <ToggleButton x:Name="measureButton" DockPanel.Dock="Right"
                                      Style="{StaticResource HeaderToggle}" Click="OnMeasureClick"
                                      ToolTip="Measure between two points on the plan. Snaps to ends, corners, centres, midpoints and crossings in either model. Right click or Esc drops the first point, and with none placed puts the tool down. Measurements stay until an element is clicked or the plan changes.">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconMeasure}" Style="{StaticResource HeaderIcon}" />
                                <TextBlock Text="MEASURE" Style="{StaticResource HeaderToggleText}" />
                            </StackPanel>
                        </ToggleButton>

                        <!--
                            What is stamped on the drawing, one group per kind of element. The
                            kinds name their results the same things - a column and a beam both
                            publish "Check state", all four publish "Revit id" - so listing them
                            together gave four identical lines and no way to tell which tick
                            belonged to what. Only the kinds that are actually on the plan are
                            listed; a tick against one that is not stays remembered for when its
                            chip comes back up.
                        -->
                        <Grid DockPanel.Dock="Right">
                            <ToggleButton x:Name="labelButton" Style="{StaticResource HeaderToggle}"
                                          IsEnabled="{Binding HasLabelFields}"
                                          ToolTip="Stamp a result on top of every element that carries it.">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconLabel}" Style="{StaticResource HeaderIcon}" />
                                    <TextBlock Text="LABEL" Style="{StaticResource HeaderToggleText}" />
                                    <Border Background="{StaticResource ColorAccent}" Padding="5,0"
                                            Margin="7,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding HasLabels, Converter={StaticResource ShowWhenTrue}}">
                                        <TextBlock Text="{Binding LabelCountText}" FontSize="11"
                                                   FontFamily="{StaticResource FontBody}"
                                                   FontWeight="SemiBold" Foreground="White" />
                                    </Border>
                                </StackPanel>
                            </ToggleButton>

                            <Popup IsOpen="{Binding IsChecked, ElementName=labelButton}"
                                   PlacementTarget="{Binding ElementName=labelButton}"
                                   Placement="Bottom" HorizontalOffset="-160" VerticalOffset="4"
                                   StaysOpen="False" AllowsTransparency="True">
                                <Border Style="{StaticResource FlyoutPanel}" Width="330" Padding="16,14">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="LABEL THE MODEL WITH"
                                                   Style="{StaticResource FlyoutHeading}" />
                                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap"
                                                   Style="{StaticResource FieldLabel}" Margin="0,0,0,10"
                                                   Text="Grouped by what publishes them, because the kinds name their results the same things. A tick stamps that value on every element of that kind and on nothing else." />

                                        <Button DockPanel.Dock="Bottom" Content="CLEAR THEM ALL"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding ClearLabelsCommand}"
                                                HorizontalAlignment="Left" Margin="0,10,0,0" />

                                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">
                                            <!-- clear of the scrollbar, so its arrows do not
                                                 read as glyphs beside the CLEAR link -->
                                            <ItemsControl ItemsSource="{Binding LabelGroups}" Margin="0,0,10,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,0,0,12">
                                                            <DockPanel Margin="0,0,0,4">
                                                                <Button DockPanel.Dock="Right" Content="CLEAR"
                                                                        Style="{StaticResource GhostButton}"
                                                                        FontSize="11" Padding="6,1"
                                                                        Command="{Binding ClearCommand}"
                                                                        Visibility="{Binding HasSelection, Converter={StaticResource ShowWhenTrue}}"
                                                                        ToolTip="Unticks this group and leaves the others as they are." />
                                                                <TextBlock Text="{Binding Title}"
                                                                           Style="{StaticResource SectionLabel}"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding CountText}"
                                                                           Style="{StaticResource CaptionText}"
                                                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                                                            </DockPanel>
                                                            <Rectangle Height="1" Margin="0,0,0,5"
                                                                       Fill="{StaticResource ColorDivider}" />
                                                            <ItemsControl ItemsSource="{Binding Options}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <CheckBox Content="{Binding Label}"
                                                                                  IsChecked="{Binding IsSelected}"
                                                                                  Margin="0,1" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <!--
                            Which results are on show. These switch results on and off, never
                            elements, so the plan is the same drawing however they are set - but
                            a result switched off here is a result nothing on screen mentions,
                            which is why the button carries a mark while any of them is.
                        -->
                        <Grid DockPanel.Dock="Right">
                            <ToggleButton x:Name="showButton" Style="{StaticResource HeaderToggle}"
                                          ToolTip="Which results are drawn, and what is drawn behind them.">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconShow}" Style="{StaticResource HeaderIcon}" />
                                    <TextBlock Text="SHOW" Style="{StaticResource HeaderToggleText}" />
                                    <Ellipse Width="7" Height="7" Margin="7,0,0,0" VerticalAlignment="Center"
                                             Fill="{DynamicResource VerdictReview}"
                                             Visibility="{Binding IsFiltered, Converter={StaticResource ShowWhenTrue}}"
                                             ToolTip="Something is switched off." />
                                </StackPanel>
                            </ToggleButton>

                            <Popup IsOpen="{Binding IsChecked, ElementName=showButton}"
                                   PlacementTarget="{Binding ElementName=showButton}"
                                   Placement="Bottom" HorizontalOffset="-160" VerticalOffset="4"
                                   StaysOpen="False" AllowsTransparency="True">
                                <Border Style="{StaticResource FlyoutPanel}" Width="330" Padding="16,14">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="WHAT IS DRAWN"
                                                   Style="{StaticResource FlyoutHeading}" />
                                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap"
                                                   Style="{StaticResource FieldLabel}" Margin="0,0,0,10"
                                                   Text="These switch results on and off, never elements. Every column and every piece of slab stays on the plan; one with all of its results switched off is drawn grey and unlabelled. Where an element has several results on show, the most serious of them gives it its colour." />

                                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="ALL RESULTS" Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding ShowAllResultsCommand}" Margin="0,0,8,0" />
                                            <Button Content="NONE" Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding HideAllResultsCommand}" />
                                        </StackPanel>

                                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">
                                            <StackPanel Margin="0,0,10,0">
                                                <ItemsControl ItemsSource="{Binding VisibleCheckGroups}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,0,0,8">
                                                                <CheckBox IsChecked="{Binding IsSelected}" IsThreeState="False"
                                                                          ToolTip="Switches the whole check on or off. It shows filled in while only some of its verdicts are on.">
                                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                                                </CheckBox>
                                                                <ItemsControl ItemsSource="{Binding Options}" Margin="18,2,0,0">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <CheckBox IsChecked="{Binding IsSelected}" Margin="0,1">
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <Rectangle Width="11" Height="11" Fill="{Binding Swatch}"
                                                                                               Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                                    <TextBlock Text="{Binding Label}" />
                                                                                </StackPanel>
                                                                            </CheckBox>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <TextBlock Text="WITH NO COUNTERPART" Style="{StaticResource FlyoutHeading}"
                                                           Margin="0,6,0,6" />
                                                <CheckBox IsChecked="{Binding ShowUnpairedEtabs}" Margin="0,1"
                                                          ToolTip="ETABS elements with no Revit counterpart.">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Rectangle Width="11" Height="11" Fill="{DynamicResource VerdictEtabsOnly}"
                                                                   Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="Unpaired ETABS" />
                                                    </StackPanel>
                                                </CheckBox>
                                                <CheckBox IsChecked="{Binding ShowUnpairedRevit}" Margin="0,1"
                                                          ToolTip="Revit elements with no ETABS counterpart.">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Rectangle Width="11" Height="11" Fill="{DynamicResource VerdictRevitOnly}"
                                                                   Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="Unpaired Revit" />
                                                    </StackPanel>
                                                </CheckBox>
                                                <CheckBox IsChecked="{Binding ShowNotChecked}" Margin="0,1"
                                                          ToolTip="Imported but not compared yet, which is everything before the first run.">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Rectangle Width="11" Height="11" Fill="#FF333333"
                                                                   Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="Not checked yet" />
                                                    </StackPanel>
                                                </CheckBox>

                                                <TextBlock Text="SETTLED" Style="{StaticResource FlyoutHeading}"
                                                           Margin="0,14,0,6" />
                                                <CheckBox IsChecked="{Binding ShowAccepted}" Margin="0,1"
                                                          ToolTip="Differences accepted as real and agreed, by hand or by the check. Switched off, they are drawn grey like any result switched off.">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Rectangle Width="11" Height="11" Fill="{DynamicResource VerdictAccepted}"
                                                                   Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="Accepted" />
                                                    </StackPanel>
                                                </CheckBox>

                                                <TextBlock Text="BEHIND THEM" Style="{StaticResource FlyoutHeading}"
                                                           Margin="0,14,0,6" />
                                                <CheckBox IsChecked="{Binding ShowContext}"
                                                          Content="Draw the rest behind it in grey" />
                                                <TextBlock Text="{Binding ContextDescription}"
                                                           Style="{StaticResource FieldLabel}"
                                                           TextWrapping="Wrap" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <Rectangle DockPanel.Dock="Right" Width="1" Height="18" Margin="14,0,4,0"
                                   Fill="{StaticResource ColorBorder}" VerticalAlignment="Center" />

                        <TextBlock DockPanel.Dock="Right" Text="{Binding StoryPosition}"
                                   Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                   Margin="12,0,0,0" />

                        <!-- stepping up and down goes by height, not by the order ETABS listed -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                            <Button Content="&#x25B2;" Command="{Binding StoryUpCommand}"
                                    Style="{StaticResource SecondaryButton}" Width="30" Padding="0,3"
                                    ToolTip="{Binding StoryUpToolTip}" />
                            <Button Content="&#x25BC;" Command="{Binding StoryDownCommand}"
                                    Style="{StaticResource SecondaryButton}" Width="30" Padding="0,3"
                                    Margin="4,0,0,0" ToolTip="{Binding StoryDownToolTip}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="LEVEL" Style="{StaticResource SectionLabel}"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding StoryTitle}" Style="{StaticResource HeadingText}"
                                       FontSize="21" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding StoryElevation}" Style="{StaticResource CaptionText}"
                                       FontSize="13" VerticalAlignment="Center" Margin="10,3,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid>
                    <!--
                        The canvas is created in the code-behind rather than declared here. The
                        legacy XAML markup compiler cannot handle a local type in this project,
                        because resolving one drags the .NET 8 Revit API assemblies into its
                        reference closure and it fails to load them.
                    -->
                    <ContentControl x:Name="canvasHost"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch" />

                    <!--
                        Only up while the selection is two elements that can be paired. It sits
                        over the plan at the top left because the whole time it is up, the
                        thing being decided is which elements are lit on the drawing behind it
                        - a panel down the side of the window would put the note and the
                        elements it is about at opposite ends of a wide screen.
                    -->
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"
                            MaxWidth="330" Padding="14,10,14,12"
                            Background="{StaticResource ColorBg}"
                            BorderBrush="{StaticResource ColorBorder}" BorderThickness="1"
                            Visibility="{Binding CanPairSelection, Converter={StaticResource ShowWhenTrue}}">
                        <StackPanel>
                            <TextBlock Text="THESE TWO CAN BE PAIRED" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding PairSelectionText}" Style="{StaticResource BodyText}"
                                       FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding PairSelectionNote}" Style="{StaticResource CaptionText}"
                                       TextWrapping="Wrap" Margin="0,3,0,0" />

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="PAIR THESE" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding PairSelectionCommand}"
                                        ToolTip="{Binding PairToolTip}" />
                                <Button Content="CLEAR" Style="{StaticResource SecondaryButton}"
                                        Margin="8,0,0,0" Command="{Binding ClearSelectionCommand}"
                                        ToolTip="Drops the selection. Nothing that is already paired changes." />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!--
                        The height zone tools, up while the height zone tab is. Bottom left, clear
                        of the pairing note at the top and of the band the plan puts across the
                        top while a zone is being drawn.
                    -->
                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,30"
                            MaxWidth="360" Padding="14,10,14,12"
                            Background="{StaticResource ColorBg}"
                            BorderBrush="{StaticResource ColorBorder}" BorderThickness="1"
                            Visibility="{Binding ShowsHeightZoneTools, Converter={StaticResource ShowWhenTrue}}">
                        <StackPanel>
                            <TextBlock Text="HEIGHT ZONES" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding HeightZoneToolsText}" Style="{StaticResource CaptionText}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="DRAW RECTANGLE" Style="{StaticResource PrimaryButton}"
                                        Click="OnDrawZoneRectangleClick"
                                        ToolTip="Click one corner, then the opposite corner. Snaps to the model." />
                                <Button Content="DRAW POLYGON" Style="{StaticResource SecondaryButton}"
                                        Margin="8,0,0,0" Click="OnDrawZonePolygonClick"
                                        ToolTip="Click the corners in order round it; click the first again, double click or press Enter to finish. Snaps to the model." />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"
                               Foreground="#FF888888" FontSize="11"
                               Text="Wheel to zoom · middle drag or ctrl+drag to pan · click to select · drag a window to add to the selection (left to right: wholly inside, right to left: touching) · shift+click or shift+drag to take out · Esc clears · ctrl+click where several overlap to say which" />

                    <!--
                        The element card. It sits against the right edge of the drawing rather
                        than docking down the side of the window, because reading a verdict
                        means looking back and forth at the element it belongs to, and a panel
                        at the far edge of a wide screen puts those two as far apart as the
                        window allows.
                    -->
                    <Border Width="340" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                            Background="{StaticResource ColorBg}"
                            BorderBrush="{StaticResource ColorBorder}" BorderThickness="1,0,0,0"
                            Visibility="{Binding HasSelection, Converter={StaticResource ShowWhenTrue}}">
                        <DockPanel DataContext="{Binding Card}" LastChildFill="True">

                            <!-- who it is -->
                            <Border DockPanel.Dock="Top" Padding="16,12,12,12"
                                    BorderBrush="{StaticResource ColorDivider}" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="CLEAR" VerticalAlignment="Top"
                                                Style="{StaticResource GhostButton}" FontSize="12"
                                                Command="{Binding DataContext.ClearSelectionCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="Put the card away and drop the selection." />
                                        <TextBlock Style="{StaticResource SectionLabel}" VerticalAlignment="Center">
                                            <Run Text="SELECTED &#183; " /><Run Text="{Binding Kind, Mode=OneWay}" />
                                        </TextBlock>
                                    </DockPanel>

                                    <TextBlock Text="{Binding Title}" Style="{StaticResource HeadingText}"
                                               FontSize="26" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}"
                                               Margin="0,1,0,0" />

                                    <!-- the verdict, read against how much was actually asked -->
                                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0"
                                                Visibility="{Binding IsFinding, Converter={StaticResource ShowWhenTrue}}">
                                        <Border Background="{DynamicResource VerdictFailed}" Padding="6,1" Margin="0,0,7,0"
                                                Visibility="{Binding HasFailed, Converter={StaticResource ShowWhenTrue}}">
                                            <TextBlock Text="{Binding FailedText}" Foreground="White" FontSize="11"
                                                       FontFamily="{StaticResource FontHeading}" FontWeight="SemiBold" />
                                        </Border>
                                        <Border Background="{DynamicResource VerdictReview}" Padding="6,1" Margin="0,0,7,0"
                                                Visibility="{Binding HasReview, Converter={StaticResource ShowWhenTrue}}">
                                            <TextBlock Text="{Binding ReviewText}" Foreground="White" FontSize="11"
                                                       FontFamily="{StaticResource FontHeading}" FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Text="{Binding OfChecksText}" Style="{StaticResource CaptionText}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- what to do about it -->
                            <Border DockPanel.Dock="Bottom" Padding="16,12"
                                    BorderBrush="{StaticResource ColorDivider}" BorderThickness="0,1,0,0">
                                <StackPanel>
                                <!--
                                    A height zone is drawn by hand and changed rather than judged,
                                    so its card offers what can be done to it in place of the
                                    review and the acceptance.
                                -->
                                <StackPanel Visibility="{Binding IsHeightZone, Converter={StaticResource ShowWhenTrue}}">
                                    <Button Content="CHANGE HEIGHT" Style="{StaticResource PrimaryButton}"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding DataContext.EditHeightZonesCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                            ToolTip="Change the height - and on one zone its name. The line loads are checked again with it." />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="COPY TO LEVELS..."
                                                Command="{Binding DataContext.CopyHeightZonesCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="Put a copy at the same place and height on the levels you tick, each to change or delete on its own." />
                                        <Button Grid.Column="2" Content="DELETE"
                                                Command="{Binding DataContext.DeleteHeightZonesCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="Take the zone away: the line loads in it go back to the floor to floor height. Asks first. The Delete key does the same." />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Visibility="{Binding IsFinding, Converter={StaticResource ShowWhenTrue}}">
                                    <Button Content="{Binding SelectInRevitText}" Style="{StaticResource PrimaryButton}"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding DataContext.SelectInRevitCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <!--
                                        A drawn line load paired with design model frames can be
                                        put on them from here. Offered on every drawn line, and
                                        greyed out on one nothing in the design model runs under.
                                    -->
                                    <Button Content="{Binding DataContext.WriteLoadBackText,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                            Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                            Command="{Binding DataContext.WriteLoadBackCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                            ToolTip="{Binding DataContext.WriteLoadBackToolTip,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                            ToolTipService.ShowOnDisabled="True"
                                            Visibility="{Binding DataContext.ShowsWriteLoadBack,
                                                         RelativeSource={RelativeSource AncestorType=Window},
                                                         Converter={StaticResource ShowWhenTrue}}" />
                                    <!--
                                        Two different statements, not one with degrees. Reviewed
                                        says somebody has looked; accepted says the difference is
                                        real and agreed, and stops it counting as work. Pressing
                                        the one already showing takes it back.
                                    -->
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="{Binding ReviewButtonText}"
                                                Command="{Binding DataContext.ToggleReviewedCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="Say you have looked at this. It stays open work. Recorded against the verdicts it is carrying now, so a later run that changes any of them asks for another look." />
                                        <Button Grid.Column="2" Content="{Binding AcceptButtonText}"
                                                Command="{Binding DataContext.ToggleAcceptedCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="{Binding DataContext.AcceptToolTip,
                                                          RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </Grid>

                                    <Button Content="{Binding NoteButtonText}" Margin="0,8,0,0"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding DataContext.AddNoteCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                            ToolTip="Write something about this element. Kept with the project." />

                                    <!--
                                        What was said, and whether it is still about this. A
                                        review made against different verdicts is shown as
                                        wanting another look rather than as clean - the element
                                        has changed since someone last looked at it.
                                    -->
                                    <TextBlock Text="{Binding ReviewState}" Margin="0,7,0,0"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasReviewState,
                                                   Converter={StaticResource ShowWhenTrue}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReviewStale}" Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource VerdictReview}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Border Margin="0,8,0,0" Padding="8,6"
                                            Background="{StaticResource ColorSurface}"
                                            Visibility="{Binding HasNote,
                                                Converter={StaticResource ShowWhenTrue}}">
                                        <StackPanel>
                                            <TextBlock Text="NOTE" Style="{StaticResource SectionLabel}" />
                                            <TextBlock Text="{Binding Note}" Style="{StaticResource BodyText}"
                                                       FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                </StackPanel>
                            </Border>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>

                                    <!-- what it was paired with, before any verdict about it -->
                                    <Border Padding="16,10,16,12"
                                            BorderBrush="{StaticResource ColorDivider}" BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="CHANGE"
                                                        Style="{StaticResource GhostButton}" FontSize="12"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding ShowsChangePairing, Converter={StaticResource ShowWhenTrue}}"
                                                        Command="{Binding DataContext.Pairing.OpenCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Element}"
                                                        ToolTip="Say which Revit element this one really goes with. The answer is kept and survives the next run." />
                                                <!-- on one pair or on every pair in a selection -->
                                                <Button DockPanel.Dock="Right"
                                                        Content="{Binding DataContext.UnpairSelectionText,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Style="{StaticResource GhostButton}" FontSize="12"
                                                        VerticalAlignment="Center" Margin="0,0,6,0"
                                                        Visibility="{Binding DataContext.CanUnpairSelection,
                                                                     RelativeSource={RelativeSource AncestorType=Window},
                                                                     Converter={StaticResource ShowWhenTrue}}"
                                                        Command="{Binding DataContext.UnpairSelectionCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                        ToolTip="Take this pair apart: the ETABS element pairs with nothing and its Revit counterpart is free. Kept like any pairing set by hand - mark the two on the plan and pair them to put it back." />
                                                <TextBlock Text="{Binding PairingHeading}" Style="{StaticResource SectionLabel}"
                                                           VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding PairingNote}" Style="{StaticResource BodyText}"
                                                       TextWrapping="Wrap" Margin="0,5,0,0" />

                                            <!--
                                                The editor opens in place, under the pairing it
                                                is about to change, rather than in a window of
                                                its own - the candidates only mean anything read
                                                against the element they belong to, which is on
                                                the plan just to the left.
                                            -->
                                            <StackPanel Margin="0,10,0,0"
                                                        DataContext="{Binding DataContext.Pairing,
                                                                     RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Visibility="{Binding IsOpen,
                                                            Converter={StaticResource ShowWhenTrue}}">

                                                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionLabel}"
                                                           TextWrapping="Wrap" Margin="0,0,0,6" />

                                                <TextBox Text="{Binding TypedId, UpdateSourceTrigger=PropertyChanged}"
                                                         Padding="5,4" FontFamily="{StaticResource FontBody}"
                                                         ToolTip="An element id read off Revit. Use this for a counterpart too far away to be listed below." />
                                                <TextBlock Style="{StaticResource CaptionText}" Margin="0,3,0,8"
                                                           Text="Type a Revit element id, or pick one below." />

                                                <TextBlock Text="NEARBY" Style="{StaticResource SectionLabel}"
                                                           Margin="0,0,0,4" />

                                                <ListBox ItemsSource="{Binding Candidates}"
                                                         SelectedItem="{Binding Selected, Mode=TwoWay}"
                                                         MaxHeight="150" BorderThickness="1"
                                                         BorderBrush="{StaticResource ColorDivider}"
                                                         Background="Transparent"
                                                         HorizontalContentAlignment="Stretch"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <DockPanel Margin="0,2">
                                                                <TextBlock DockPanel.Dock="Right"
                                                                           Text="{Binding DistanceText}"
                                                                           Style="{StaticResource CaptionText}"
                                                                           VerticalAlignment="Center"
                                                                           Margin="8,0,0,0" />
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Title}"
                                                                               Style="{StaticResource BodyText}"
                                                                               FontSize="12" />
                                                                    <TextBlock Text="{Binding Note}"
                                                                               Style="{StaticResource CaptionText}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>

                                                <TextBlock Text="{Binding Footnote}" Style="{StaticResource CaptionText}"
                                                           Margin="0,5,0,8" />

                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="PAIR &amp; RE-CHECK"
                                                            Style="{StaticResource PrimaryButton}"
                                                            Command="{Binding ApplyCommand}" />
                                                    <Button Content="CANCEL" Margin="8,0,0,0"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Command="{Binding CancelCommand}" />
                                                </StackPanel>

                                                <DockPanel Margin="0,8,0,0">
                                                    <Button DockPanel.Dock="Right" Content="UNPAIR"
                                                            Style="{StaticResource GhostButton}" FontSize="12"
                                                            Command="{Binding UnpairCommand}"
                                                            ToolTip="Say this pairs with nothing. That is an answer, and it is kept like any other." />
                                                    <TextBlock Style="{StaticResource CaptionText}"
                                                               VerticalAlignment="Center" TextWrapping="Wrap"
                                                               Text="A pairing set by hand survives the next run." />
                                                </DockPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- every check that ran, with the two values it compared -->
                                    <StackPanel Margin="16,10,16,12">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="76" />
                                                <ColumnDefinition Width="66" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="CHECKS" Style="{StaticResource SectionLabel}" />
                                            <TextBlock Grid.Column="1" Text="ETABS" Style="{StaticResource SectionLabel}"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="2" Text="REVIT" Style="{StaticResource SectionLabel}"
                                                       HorizontalAlignment="Right" />
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding Rows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!--
                                                        A check whose switch is off is dimmed,
                                                        not dropped: the card is where you come
                                                        to find out what is wrong with this one
                                                        element, and a filter set for the plan
                                                        should not hide a verdict in the one
                                                        place it was asked for.
                                                    -->
                                                    <Border BorderBrush="{StaticResource ColorDivider}"
                                                            BorderThickness="0,0,0,1" Padding="0,7">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                                        <Setter Property="Opacity" Value="0.4" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="76" />
                                                                    <ColumnDefinition Width="66" />
                                                                </Grid.ColumnDefinitions>

                                                                <Rectangle Grid.Column="0" Width="9" Height="9"
                                                                           Margin="0,3,8,0" VerticalAlignment="Top"
                                                                           Fill="{Binding Swatch}" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Label}"
                                                                           Style="{StaticResource BodyText}"
                                                                           TextWrapping="Wrap" Margin="0,0,6,0" />

                                                                <!-- the failing value carries the red, not the whole row -->
                                                                <TextBlock Grid.Column="2" Text="{Binding Etabs}"
                                                                           HorizontalAlignment="Right"
                                                                           TextAlignment="Right" TextWrapping="Wrap">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsFailure}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource VerdictFailed}" />
                                                                                    <Setter Property="FontWeight" Value="Bold" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>

                                                                <TextBlock Grid.Column="3" Text="{Binding Revit}"
                                                                           Style="{StaticResource BodyText}"
                                                                           Foreground="{StaticResource ColorNeutral700}"
                                                                           HorizontalAlignment="Right"
                                                                           TextAlignment="Right" TextWrapping="Wrap" />
                                                            </Grid>

                                                            <!--
                                                                A check with no two sides to
                                                                show - a pairing that never
                                                                happened, a piece of slab with
                                                                no loading region over it -
                                                                falls back to the sentence it
                                                                wrote itself.
                                                            -->
                                                            <TextBlock Text="{Binding Summary}"
                                                                       Style="{StaticResource CaptionText}"
                                                                       Margin="17,2,0,0"
                                                                       Visibility="{Binding ShowsSummary,
                                                                           Converter={StaticResource ShowWhenTrue}}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- what it is, under what is wrong with it -->
                                        <ItemsControl ItemsSource="{Binding Facts}" Margin="0,10,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!--
                                                        A fact that is really one number per
                                                        model - a beam's width, a slab's depth -
                                                        lines up under the same ETABS and Revit
                                                        headings the checks above use, because
                                                        that is the column the eye reads down.
                                                        Anything with only one value spans both.
                                                    -->
                                                    <Grid Margin="0,0,0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="76" />
                                                            <ColumnDefinition Width="66" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                                   Style="{StaticResource CaptionText}"
                                                                   Margin="0,0,6,0" />

                                                        <TextBlock Grid.Column="1" Text="{Binding Etabs}"
                                                                   Style="{StaticResource CaptionText}"
                                                                   Foreground="{StaticResource ColorText}"
                                                                   HorizontalAlignment="Right" TextAlignment="Right"
                                                                   Visibility="{Binding HasSides,
                                                                       Converter={StaticResource ShowWhenTrue}}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Revit}"
                                                                   Style="{StaticResource CaptionText}"
                                                                   Foreground="{StaticResource ColorText}"
                                                                   HorizontalAlignment="Right" TextAlignment="Right"
                                                                   Visibility="{Binding HasSides,
                                                                       Converter={StaticResource ShowWhenTrue}}" />

                                                        <TextBlock Grid.Column="1" Grid.ColumnSpan="2"
                                                                   Text="{Binding Value}"
                                                                   Style="{StaticResource CaptionText}"
                                                                   Foreground="{StaticResource ColorText}"
                                                                   HorizontalAlignment="Right" TextAlignment="Right"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Visibility="{Binding ShowsValue,
                                                                       Converter={StaticResource ShowWhenTrue}}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </Border>

    </DockPanel>
</Window>
