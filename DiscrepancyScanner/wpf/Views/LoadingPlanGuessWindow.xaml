<Window x:Class="DiscrepancyScanner.Wpf.LoadingPlanGuessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Guess loading plans by name"
        Height="640" Width="900" MinHeight="420" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ColorBg}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Theme/Industry.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="ShowWhenTrue" />

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#FF555555" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="MinWidth" Value="86" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>

        <!-- what this window is for -->
        <Border DockPanel.Dock="Top" Background="{StaticResource ColorBg}" Padding="18,12"
                BorderBrush="{StaticResource ColorBorder}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="GUESS BY NAME" Style="{StaticResource BrandText}" />
                <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0" TextWrapping="Wrap"
                           Text="Tick the levels to guess. Each one is offered only the views whose name carries the level's name - or a run it is in, like L05-L20 - and the text below. A level whose name is on no view is offered the view of the master story ETABS says it is similar to. Where more than one view qualifies, pick it in the list. Nothing is paired until Apply." />
            </StackPanel>
        </Border>

        <!-- the way out -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource ColorSurface}" Padding="18,10"
                BorderBrush="#FFCCCCCC" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="CANCEL" IsCancel="True" Margin="10,0,0,0" />
                <Button DockPanel.Dock="Right" Content="APPLY" IsDefault="True"
                        Style="{StaticResource PrimaryButton}" FontWeight="SemiBold"
                        Command="{Binding ApplyCommand}" />
                <TextBlock Text="{Binding Summary}" VerticalAlignment="Center"
                           TextWrapping="Wrap" Margin="0,0,12,0" />
            </DockPanel>
        </Border>

        <!-- what the guess looks for, and what the guessed levels read -->
        <Border DockPanel.Dock="Top" Padding="18,12,18,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="The view name contains one of" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Padding="6,3" VerticalContentAlignment="Center"
                             Text="{Binding LoadingPlanMarkers, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,4,0,0"
                               Text="Comma separated for a job that uses more than one wording - any one of them will do." />

                    <TextBlock Text="and all of" FontWeight="SemiBold" Margin="0,10,0,4" />
                    <TextBox Padding="6,3" VerticalContentAlignment="Center"
                             Text="{Binding RequiredText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="For example: TOWER A, SDL" />
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,4,0,0"
                               Text="Comma separated, and every one must be in the name - for a floor with several loading plans, one per tower or SDL apart from live load. Leave empty to ask for nothing more. Both are matched anywhere in the name, ignoring case, spaces, dashes and underscores, and kept with the rest of the settings." />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Loading schedule" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Content="Import loading schedule..."
                                Command="{Binding PickWorkbookCommand}" />
                        <TextBlock Text="{Binding WorkbookName}" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </DockPanel>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Area load sheet" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                            <ComboBox ItemsSource="{Binding ScheduleSheets}"
                                      SelectedItem="{Binding SelectedAreaSheet}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Line load sheet" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                            <ComboBox ItemsSource="{Binding ScheduleSheets}"
                                      SelectedItem="{Binding SelectedLineSheet}"
                                      ToolTip="Leave it empty to check the guessed levels' area loads only." />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- the levels -->
        <DockPanel Margin="18,8,18,14">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Levels to guess" FontWeight="Bold" VerticalAlignment="Center"
                           Margin="0,0,14,0" />
                <Button Content="All" Command="{Binding SelectAllCommand}" MinWidth="60" />
                <Button Content="None" Command="{Binding SelectNoneCommand}" MinWidth="60" Margin="6,0,0,0" />
                <Button Content="Unpaired only" Command="{Binding SelectUnpairedCommand}" Margin="6,0,0,0" />
            </StackPanel>

            <ListBox ItemsSource="{Binding Rows}" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <CheckBox IsChecked="{Binding IsChosen}" FontWeight="SemiBold">
                                    <TextBlock Text="{Binding Story}" TextTrimming="CharacterEllipsis" />
                                </CheckBox>
                                <TextBlock Text="{Binding CurrentState}" TextTrimming="CharacterEllipsis"
                                           Margin="20,0,0,0" ToolTip="{Binding CurrentState}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
                                            <Setter Property="TextWrapping" Value="NoWrap" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentState}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <ComboBox Grid.Column="1" VerticalAlignment="Top" Margin="8,0,8,0"
                                      ItemsSource="{Binding Candidates}"
                                      SelectedItem="{Binding PickedView}"
                                      DisplayMemberPath="DisplayName"
                                      IsEnabled="{Binding HasCandidates}" />

                            <TextBlock Grid.Column="2" Text="{Binding MatchText}" VerticalAlignment="Top"
                                       Margin="0,3,0,0" FontSize="11" Foreground="#FF666666" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </DockPanel>
</Window>
