<Window x:Class="DiscrepancyScanner.Wpf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set up"
        Height="760" Width="1060" MinHeight="520" MinWidth="820"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ColorBg}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Theme/Industry.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="ShowWhenTrue" />

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,2" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF555555" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="MinWidth" Value="86" />
        </Style>

        <!--
            One settings row. The three editors sit side by side and all but the one this
            setting wants is collapsed, rather than a template being chosen by type: the
            markup compiler in this project cannot resolve a local type, so nothing here may
            name one. See the note in CheckWindow.xaml.
        -->
        <DataTemplate x:Key="SettingRow">
            <Border Margin="0,0,0,16" Padding="10,0,0,0"
                    BorderBrush="#FF2C7BD6" BorderThickness="0,0,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <!-- A bar down the side of anything left away from its default. -->
                            <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                <Setter Property="BorderThickness" Value="3,0,0,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>

                    <!-- a switch -->
                    <CheckBox Content="{Binding Label}" IsChecked="{Binding BoolValue}"
                              FontWeight="SemiBold" Margin="0,0,0,3"
                              Visibility="{Binding IsBool, Converter={StaticResource ShowWhenTrue}}" />

                    <!-- free text, usually a comma separated list -->
                    <StackPanel Visibility="{Binding IsText, Converter={StaticResource ShowWhenTrue}}">
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="0,0,0,3" />
                        <TextBox Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="3,2" Margin="0,0,0,3" />
                    </StackPanel>

                    <!-- a number, with its unit beside it -->
                    <StackPanel Visibility="{Binding IsNumber, Converter={StaticResource ShowWhenTrue}}">
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="0,0,0,3" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBox Width="120" Padding="3,2"
                                     Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                                <Setter Property="BorderBrush" Value="#FFB30F14" />
                                                <Setter Property="BorderThickness" Value="2" />
                                                <Setter Property="ToolTip" Value="This has to be a number. Nothing is saved until it is." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <TextBlock Text="{Binding Unit}" VerticalAlignment="Center" Margin="6,0,0,0"
                                       Foreground="#FF555555"
                                       Visibility="{Binding HasUnit, Converter={StaticResource ShowWhenTrue}}" />
                        </StackPanel>
                    </StackPanel>

                    <!--
                        a key: the box takes the next key pressed in it, with whatever modifiers
                        are held, rather than text typed into it - see OnShortcutBoxKeyDown
                    -->
                    <StackPanel Visibility="{Binding IsKey, Converter={StaticResource ShowWhenTrue}}">
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="0,0,0,3" />
                        <TextBox Width="180" HorizontalAlignment="Left" Padding="3,2" Margin="0,0,0,3"
                                 IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="Hand"
                                 Text="{Binding TextValue, Mode=OneWay}"
                                 PreviewKeyDown="OnShortcutBoxKeyDown"
                                 ToolTip="Click here and press the key - or two keys one straight after the other, for a pair like A, A. Backspace or Delete takes it away.">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter Property="BorderBrush" Value="#FF2C7BD6" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                            <Setter Property="BorderBrush" Value="#FFB30F14" />
                                            <Setter Property="BorderThickness" Value="2" />
                                            <Setter Property="ToolTip" Value="This is not a key. Click here and press the one you want." />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </StackPanel>

                    <TextBlock Text="{Binding Description}" Style="{StaticResource FieldLabel}"
                               Visibility="{Binding HasDescription, Converter={StaticResource ShowWhenTrue}}" />

                    <!--
                        When the change is picked up. A setting read while a model is being
                        imported cannot touch the model already in memory, and saying so here
                        is the difference between "this does not work" and "import it again".
                    -->
                    <TextBlock Text="{Binding Applies}" Margin="0,4,0,0" FontSize="11" FontStyle="Italic"
                               Foreground="#FF7B6A4E" TextWrapping="Wrap"
                               Visibility="{Binding HasApplies, Converter={StaticResource ShowWhenTrue}}" />

                    <TextBlock Text="{Binding Note}" Margin="0,3,0,0" FontSize="11" Foreground="#FF2C7BD6"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasNote, Converter={StaticResource ShowWhenTrue}}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>

        <!-- what the buttons at the foot do -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource ColorSurface}"
                BorderBrush="{StaticResource ColorBorder}" BorderThickness="0,1,0,0" Padding="14,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ContentControl Style="{StaticResource BlueprintCard}" Background="Transparent"
                                    BorderThickness="0" Margin="8" VerticalAlignment="Center">
                        <Button Content="DONE" IsDefault="True" Click="OnOkClick"
                                Style="{StaticResource PrimaryButton}" Padding="18,7" />
                    </ContentControl>
                    <Button Content="CANCEL" IsCancel="True" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button DockPanel.Dock="Left" Content="Restore defaults" MinWidth="120"
                        Command="{Binding RestoreDefaultsCommand}"
                        ToolTip="Puts the defaults back, for whatever is on screen. Your own saved defaults if you have any, otherwise the ones the tool ships with." />
                <!--
                    The settings file was always one per user rather than one per project, so
                    this is not copying anything anywhere: it says which values count as the
                    default that new work starts from and that Restore puts back.
                -->
                <Button DockPanel.Dock="Left" Content="Save as my defaults" MinWidth="140" Margin="8,0,0,0"
                        Command="{Binding SaveAsDefaultsCommand}"
                        ToolTip="Makes these settings the ones every project starts from. Alignment and loading plan pairings stay with their own project and are not included." />
                <Button DockPanel.Dock="Left" Content="Forget mine" MinWidth="90" Margin="8,0,0,0"
                        Command="{Binding ForgetDefaultsCommand}"
                        ToolTip="Drops your saved defaults so the ones the tool ships with count again. Nothing on screen changes." />
                <StackPanel VerticalAlignment="Center" Margin="12,0">
                    <TextBlock Text="{Binding ChangedSummary}" Style="{StaticResource FieldLabel}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding DefaultsSummary}" Style="{StaticResource FieldLabel}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!--
            The window says what it is for before it says what is in it: everything here is
            tuned once for a project and then left, which is exactly what the check window is
            not, and that difference is the reason the two are separate windows at all.
        -->
        <Border DockPanel.Dock="Top" Background="{StaticResource ColorBg}"
                BorderBrush="{StaticResource ColorBorder}" BorderThickness="0,0,0,1"
                Padding="18,14,18,12">
            <StackPanel>
                <TextBlock Text="SET UP" Style="{StaticResource BrandText}" />
                <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                           Text="Everything tuned once per project. The check window keeps none of it." />
            </StackPanel>
        </Border>

        <!-- search cuts across every group at once -->
        <Border DockPanel.Dock="Top" Background="#FFFAFAFA"
                BorderBrush="#FFDDDDDD" BorderThickness="0,0,0,1" Padding="12,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Clear" MinWidth="60" Margin="8,0,0,0"
                        Command="{Binding ClearSearchCommand}" />
                <Grid>
                    <TextBox x:Name="searchBox" Padding="4,4"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Search every setting - try a word, a unit, or a number"
                               IsHitTestVisible="False" Margin="7,0,0,0"
                               VerticalAlignment="Center" Foreground="#FF999999">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=searchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
        </Border>

        <!-- the groups, down the side -->
        <Border DockPanel.Dock="Left" Width="215" Background="{StaticResource ColorBg}"
                BorderBrush="{StaticResource ColorDivider}" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource FieldLabel}" Margin="12,8"
                           Text="Searching looks through all of them at once."
                           Visibility="{Binding IsSearching, Converter={StaticResource ShowWhenTrue}}" />
                <ListBox ItemsSource="{Binding CategoriesView}" SelectedItem="{Binding SelectedCategory}"
                         BorderThickness="0" Background="Transparent" Padding="0,6"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource SectionLabel}"
                                               Margin="12,12,12,4" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,7" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Style.Triggers>
                                <!-- A group a search has nothing in is dimmed rather than removed. -->
                                <DataTrigger Binding="{Binding HasMatches}" Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <!-- a page of its own has no settings to count -->
                                <TextBlock DockPanel.Dock="Right" Text="{Binding MatchCount}"
                                           VerticalAlignment="Center" Margin="6,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPane}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap"
                                           Style="{StaticResource BodyText}" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- the settings themselves, or one of the two pages that are not settings -->
        <Grid>

            <!--
                Models and alignment. Moved here out of the check window: it is done once for a
                project and then left, which is the whole rule this window is sorted by, and it
                was taking up the top third of a panel meant for reading results.
            -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,16"
                          Visibility="{Binding ShowsModels, Converter={StaticResource ShowWhenTrue}}">
                <StackPanel DataContext="{Binding Owner}" MaxWidth="620" HorizontalAlignment="Left">
                    <GroupBox Header="1. Import">
                        <StackPanel>
                            <TextBlock Text="Which program the design model is in"
                                       Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding CsiProductChoices}"
                                      SelectedItem="{Binding CsiProduct}" Margin="0,0,0,6" />

                            <CheckBox Content="Read from a saved file" IsChecked="{Binding ImportFromFile}" />
                            <Button Content="{Binding ImportDesignModelText}" Command="{Binding ImportEtabsCommand}" />

                            <!--
                                SAFE only. Which Revit level a SAFE model is comes from the
                                alignment's story and level pairing - its one story is the one
                                paired - so there is no second place here to say it.
                            -->
                            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="{Binding IsSingleLevelProduct, Converter={StaticResource ShowWhenTrue}}"
                                       Text="Which Revit level the SAFE model is comes from the alignment: pair its story with a Revit level there." />

                            <!--
                                The same file the box above reads, written from this side.
                                It was only ever writable from inside ETABS, which is the one
                                place the model is already open; here it is a model that can
                                be handed on with the Revit file and checked again by somebody
                                with no ETABS licence at all.
                            -->
                            <Button Content="{Binding ExportDesignModelText}"
                                    Command="{Binding ExportEtabsCommand}" Margin="0,6,0,0"
                                    ToolTip="Writes what has been imported as the file the box above reads back." />

                            <Button Content="Import Revit model" Command="{Binding ImportRevitCommand}"
                                    Margin="0,8,0,0" />
                            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="Which parameters are read off the Revit elements is under Settings, in Revit parameters." />
                        </StackPanel>
                    </GroupBox>

                    <!--
                        Alignment has a window of its own now, and one that is not a dialog.
                        This one is, and a dialog disables every window belonging to the
                        process - Revit's own included, since the add-in runs on Revit's
                        thread. So the one page whose whole job was to pick points in Revit
                        was the one page that could not. The button closes this window on the
                        way there.
                    -->
                    <GroupBox Header="2. Align Revit to ETABS">
                        <StackPanel>
                            <TextBlock Text="{Binding Alignment.Status}" Style="{StaticResource FieldLabel}"
                                       TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="Two points that are the same physical point in both models is all it takes. Pick the pair straight off the plan - the point on the Revit model, then where it belongs on the ETABS model - or pick in Revit and type the ETABS coordinate. A second pair sets the angle." />
                            <Button Content="Open the alignment window..." HorizontalAlignment="Left"
                                    Command="{Binding DataContext.OpenAlignmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="Closes this window and opens the alignment panel beside the plan." />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!--
                What the check is run over. The tolerances it is run to are settings like any
                other and live in the pages below; this is the scope, which is a different
                question and the one asked first.
            -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,16"
                          Visibility="{Binding ShowsScope, Converter={StaticResource ShowWhenTrue}}">
                <StackPanel DataContext="{Binding Owner}" MaxWidth="620" HorizontalAlignment="Left">
                    <GroupBox Header="What the check runs over">
                        <StackPanel>
                            <TextBlock Text="Levels to check the slabs on" FontWeight="Bold" Margin="0,0,0,2" />
                            <CheckBox Content="Every level" IsChecked="{Binding CheckEveryStory}"
                                      ToolTip="Untick to check a single level, which is much quicker on a large model." />
                            <ComboBox ItemsSource="{Binding Stories}" SelectedItem="{Binding SlabCheckStory}"
                                      DisplayMemberPath="DisplayName" Margin="16,4,0,0"
                                      IsEnabled="{Binding CheckOneStoryOnly}" />
                            <TextBlock Text="{Binding SlabCheckScopeDescription}" Style="{StaticResource FieldLabel}"
                                       TextWrapping="Wrap" Margin="0,4,0,8" />

                            <!--
                                The loading plan. Which view carries the plan for a floor and
                                which schedule sheet its numbers are on is a table of every
                                level rather than a pair of pickers, so it lives in a window of
                                its own; what belongs here is the switch and where things stand.
                            -->
                            <Separator Margin="0,2,0,6" />
                            <CheckBox Content="Also check the loads on each ETABS shell"
                                      IsChecked="{Binding CheckSlabLoads}" FontWeight="Bold"
                                      ToolTip="Compares SDL, LL, LR and MEP on the ETABS shell against the loading plan and its schedule." />

                            <StackPanel Margin="16,4,0,0"
                                        Visibility="{Binding CheckSlabLoads, Converter={StaticResource ShowWhenTrue}}">
                                <Button Content="Loading plans..." Command="{Binding OpenLoadingPlansCommand}"
                                        ToolTip="Pair each ETABS level with the view its loading plan is drawn in and the schedule sheet its numbers are on." />
                                <TextBlock Text="{Binding LoadingPlanDescription}" Style="{StaticResource FieldLabel}"
                                           TextWrapping="Wrap" Margin="0,2,0,4" />
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!--
                        Everything decided by hand on this project, and the way to start it
                        again. Here rather than beside the plan because it is a project-wide
                        act done rarely and on purpose - and it asks before it does anything.
                    -->
                    <GroupBox Header="Decided by hand" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding DecisionsDescription}" Style="{StaticResource FieldLabel}"
                                       TextWrapping="Wrap" Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Forget..." MinWidth="110"
                                        Command="{Binding ForgetDecisionsCommand}"
                                        ToolTip="For this project only: asks which to forget - acceptances, reviews, notes, pairings set by hand, loading plan pairings, height zones, or everything." />
                                <Button Content="Export project..." MinWidth="130" Margin="8,0,0,0"
                                        Command="{Binding ExportProjectCommand}"
                                        ToolTip="Write everything decided on this project to a file - the alignment, the SAFE level, the loading plans, the pairings set by hand, the reviews, acceptances and notes, and the height zones - to hand on or keep with the job." />
                                <Button Content="Import project..." MinWidth="130" Margin="8,0,0,0"
                                        Command="{Binding ImportProjectCommand}"
                                        ToolTip="Read a project file into this project, in place of what it has. Says what the file holds and asks first." />
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,16,18,16"
                          Visibility="{Binding ShowsSettings, Converter={StaticResource ShowWhenTrue}}">
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="{Binding Header}" FontSize="16" FontWeight="Bold"
                                           Margin="0,0,0,3" />
                                <TextBlock Text="{Binding Blurb}" Style="{StaticResource FieldLabel}"
                                           Margin="0,0,0,14"
                                           Visibility="{Binding HasBlurb, Converter={StaticResource ShowWhenTrue}}" />
                                <ItemsControl ItemsSource="{Binding Items}"
                                              ItemTemplate="{StaticResource SettingRow}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="Nothing here matches that." Foreground="#FF888888"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding HasNoMatches, Converter={StaticResource ShowWhenTrue}}" />
        </Grid>

    </DockPanel>
</Window>
