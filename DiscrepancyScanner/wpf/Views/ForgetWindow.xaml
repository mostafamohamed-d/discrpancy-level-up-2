<Window x:Class="DiscrepancyScanner.Wpf.ForgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Forget"
        Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ColorBg}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Theme/Industry.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="18,16">
        <TextBlock DockPanel.Dock="Top" Text="FORGET ON THIS PROJECT" Style="{StaticResource SectionLabel}" />
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                   Margin="0,4,0,14"
                   Text="Tick what to forget. Only this project is touched, and it cannot be undone. The models, the alignment and the settings are kept." />

        <!--
            Cancel is the default, so Enter backs out: nothing here should happen by a key
            pressed out of habit.
        -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="{Binding ForgetButtonText}" Click="OnForgetClick" MinWidth="110"
                    IsEnabled="{Binding CanForget}" Style="{StaticResource PrimaryButton}" />
            <Button Content="CANCEL" IsCancel="True" IsDefault="True" MinWidth="90" Margin="8,0,0,0"
                    Style="{StaticResource SecondaryButton}" />
        </StackPanel>

        <StackPanel>
            <CheckBox IsChecked="{Binding Everything}" IsThreeState="False" Margin="0,0,0,8"
                      IsEnabled="{Binding HasAny}"
                      ToolTip="Ticks every line below. Shows filled in while only some of them are ticked.">
                <TextBlock Text="Everything" FontWeight="SemiBold" />
            </CheckBox>
            <Rectangle Height="1" Fill="{StaticResource ColorDivider}" Margin="0,0,0,10" />

            <ItemsControl ItemsSource="{Binding Options}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,10" IsEnabled="{Binding HasAny}">
                            <CheckBox IsChecked="{Binding IsSelected}">
                                <TextBlock>
                                    <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text="   " />
                                    <Run Text="{Binding CountText, Mode=OneWay}"
                                         Foreground="{StaticResource ColorTextMuted}" />
                                </TextBlock>
                            </CheckBox>
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}"
                                       TextWrapping="Wrap" Margin="20,2,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </DockPanel>
</Window>
