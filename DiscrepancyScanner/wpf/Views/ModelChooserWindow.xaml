<Window x:Class="DiscrepancyScanner.Wpf.ModelChooserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Which model?"
        Height="420" Width="620" MinHeight="320" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ColorBg}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Theme/Industry.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#FF555555" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="MinWidth" Value="86" />
                <Setter Property="Margin" Value="6,0,0,0" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="16">

        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="These are the models open on this machine. Pick the one to read." />

        <!-- Buttons before the list, so the list takes what is left rather than the other way round. -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Refresh" Click="OnRefreshClick" />
            <Button Content="Cancel" IsCancel="True" />
            <Button Content="Read this model" Click="OnChooseClick" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" MinWidth="120" Margin="6,0,0,0" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" x:Name="problemText" Style="{StaticResource FieldLabel}"
                   Margin="0,8,0,0" Visibility="Collapsed" />

        <ListBox x:Name="instanceList" MouseDoubleClick="OnListDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,4">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" />
                        <TextBlock Text="{Binding Location}" Style="{StaticResource FieldLabel}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
