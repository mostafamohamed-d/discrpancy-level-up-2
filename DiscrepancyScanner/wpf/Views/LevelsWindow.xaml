<Window x:Class="DiscrepancyScanner.Wpf.LevelsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copy to levels"
        Width="420" Height="560" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ColorBg}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Theme/Industry.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="18,16">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Heading}" Style="{StaticResource SectionLabel}" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding About}" Style="{StaticResource CaptionText}"
                   TextWrapping="Wrap" Margin="0,4,0,10" />

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="ALL" Style="{StaticResource GhostButton}" Command="{Binding AllCommand}" />
            <Button Content="NONE" Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                    Command="{Binding NoneCommand}" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="{Binding ApplyText}" Click="OnCopyClick" MinWidth="110"
                    IsEnabled="{Binding CanApply}" Style="{StaticResource PrimaryButton}" />
            <Button Content="CANCEL" IsCancel="True" IsDefault="True" MinWidth="90" Margin="8,0,0,0"
                    Style="{StaticResource SecondaryButton}" />
        </StackPanel>

        <Border BorderBrush="{StaticResource ColorBorder}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Levels}" Margin="8,6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2">
                                <TextBlock>
                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                    <Run Text="   " />
                                    <Run Text="{Binding Detail, Mode=OneWay}"
                                         Foreground="{StaticResource ColorTextMuted}" />
                                </TextBlock>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
