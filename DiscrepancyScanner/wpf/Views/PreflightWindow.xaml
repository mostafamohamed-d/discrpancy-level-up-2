<Window x:Class="DiscrepancyScanner.Wpf.PreflightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Before this can run"
        SizeToContent="Height" Width="660" MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource ColorBg}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Theme/Industry.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="ShowWhenTrue" />

            <!--
                One row per thing standing in the way, or already dealt with. The mark down the
                left is a number while it is a blocker, so the headline's count can be followed
                down the list, and a tick once it is done.
            -->
            <DataTemplate x:Key="PreflightRow">
                <Grid Margin="0,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- a blocker is numbered, so the headline's count can be followed down -->
                    <Border Grid.Column="0" Width="26" Height="26" VerticalAlignment="Top"
                            BorderThickness="1" BorderBrush="{Binding Swatch}"
                            Visibility="{Binding IsNumbered, Converter={StaticResource ShowWhenTrue}}">
                        <TextBlock Text="{Binding Number}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                                   FontFamily="{StaticResource FontHeading}"
                                   Foreground="{Binding Swatch}" />
                    </Border>

                    <!-- a warning is marked but not numbered: it is not one of the things missing -->
                    <Grid Grid.Column="0" Width="26" Height="26" VerticalAlignment="Top"
                          Visibility="{Binding IsWarning, Converter={StaticResource ShowWhenTrue}}">
                        <Ellipse Width="20" Height="20" StrokeThickness="1"
                                 Stroke="{Binding Swatch}" />
                        <TextBlock Text="!" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="13" FontWeight="SemiBold"
                                   FontFamily="{StaticResource FontHeading}"
                                   Foreground="{Binding Swatch}" />
                    </Grid>

                    <TextBlock Grid.Column="0" Text="✓" FontSize="17" VerticalAlignment="Top"
                               HorizontalAlignment="Center" Margin="0,2,0,0"
                               Foreground="{Binding Swatch}"
                               Visibility="{Binding IsDone, Converter={StaticResource ShowWhenTrue}}" />

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="15"
                                   Foreground="{StaticResource ColorText}" />
                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,3,0,0"
                                   Style="{StaticResource CaptionText}" />
                    </StackPanel>

                    <Button Grid.Column="3" Content="{Binding ActionText}" VerticalAlignment="Top"
                            Margin="14,0,0,0" MinWidth="120" Padding="12,7"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding Action}"
                            Visibility="{Binding HasAction, Converter={StaticResource ShowWhenTrue}}" />
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <!-- the framed card the design draws this as, with its registration marks -->
    <Border BorderBrush="{StaticResource ColorText}" BorderThickness="1" Padding="30,28">
        <StackPanel>
            <TextBlock Text="{Binding Kicker}" Style="{StaticResource SectionLabel}" />
            <TextBlock Text="{Binding Headline}" Style="{StaticResource HeadingText}"
                       FontSize="30" Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Subhead}" Style="{StaticResource BodyText}"
                       Foreground="{StaticResource ColorNeutral800}" TextWrapping="Wrap"
                       Margin="0,8,0,0" MaxWidth="500" HorizontalAlignment="Left" />

            <Border Margin="0,20,0,0" BorderThickness="0,1,0,0"
                    BorderBrush="{StaticResource ColorDivider}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="360">
                    <ItemsControl ItemsSource="{Binding Items}"
                                  ItemTemplate="{StaticResource PreflightRow}" />
                </ScrollViewer>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                <Button Content="{Binding FixEverythingText}" Style="{StaticResource PrimaryButton}"
                        Padding="18,10" Click="OnFixEverythingClick"
                        Visibility="{Binding CanFixEverything, Converter={StaticResource ShowWhenTrue}}"
                        ToolTip="Does everything numbered above, in order, and then runs the check." />

                <Button Content="RUN ANYWAY" Style="{StaticResource SecondaryButton}"
                        Padding="18,10" Margin="8,0,0,0" Click="OnRunAnywayClick"
                        Visibility="{Binding CanRunAnyway, Converter={StaticResource ShowWhenTrue}}"
                        ToolTip="{Binding RunAnywayNote}" />

                <Button Content="NOT NOW" Style="{StaticResource GhostButton}"
                        Padding="18,10" Margin="8,0,0,0" IsCancel="True" Click="OnNotNowClick" />

                <TextBlock Text="{Binding RunAnywayNote}" Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap"
                           MaxWidth="230" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
