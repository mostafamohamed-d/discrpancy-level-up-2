<Window x:Class="DiscrepancyScanner.Wpf.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Note"
        Height="260" Width="460" MinHeight="220" MinWidth="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ColorBg}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Theme/Industry.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="NOTE" Style="{StaticResource SectionLabel}" />
        <TextBlock DockPanel.Dock="Top" x:Name="aboutText" Style="{StaticResource CaptionText}"
                   Margin="0,2,0,10" TextTrimming="CharacterEllipsis" />

        <!--
            An empty note is how a note is taken back, so Save stays enabled on an empty box -
            clearing the text and saving has to mean something, or the only way to remove a note
            would be to type a space.
        -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="SAVE" IsDefault="True" Click="OnSaveClick" MinWidth="90"
                    Style="{StaticResource PrimaryButton}" />
            <Button Content="CANCEL" IsCancel="True" MinWidth="90" Margin="8,0,0,0"
                    Style="{StaticResource SecondaryButton}" />
        </StackPanel>

        <TextBox x:Name="noteBox" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Padding="6"
                 FontFamily="{StaticResource FontBody}" FontSize="13" />
    </DockPanel>
</Window>
