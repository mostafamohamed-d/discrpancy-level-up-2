<Window x:Class="DiscrepancyScanner.Wpf.LoadingPlanCopyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copy loading plan to levels"
        Height="600" Width="640" MinHeight="400" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ColorBg}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Theme/Industry.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#FF555555" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="MinWidth" Value="86" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>

        <!-- what is being copied -->
        <Border DockPanel.Dock="Top" Background="{StaticResource ColorBg}" Padding="18,12"
                BorderBrush="{StaticResource ColorBorder}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="COPY TO" Style="{StaticResource BrandText}" />
                <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" Margin="0,4,0,0" />

                <CheckBox IsChecked="{Binding CopyView}" Margin="0,10,0,0">
                    <TextBlock>
                        <Run Text="View:" FontWeight="SemiBold" />
                        <Run Text="{Binding SourceView, Mode=OneWay}" />
                    </TextBlock>
                </CheckBox>
                <CheckBox IsChecked="{Binding CopySheets}" Margin="0,6,0,0">
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="Schedule:" FontWeight="SemiBold" />
                        <Run Text="{Binding SourceSheets, Mode=OneWay}" />
                    </TextBlock>
                </CheckBox>
            </StackPanel>
        </Border>

        <!-- the way out -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource ColorSurface}" Padding="18,10"
                BorderBrush="#FFCCCCCC" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="CANCEL" IsCancel="True" Margin="10,0,0,0" />
                <Button DockPanel.Dock="Right" Content="APPLY" IsDefault="True"
                        Style="{StaticResource PrimaryButton}" FontWeight="SemiBold"
                        Command="{Binding ApplyCommand}" />
                <TextBlock Text="{Binding Summary}" VerticalAlignment="Center"
                           TextWrapping="Wrap" Margin="0,0,12,0" />
            </DockPanel>
        </Border>

        <!-- the levels -->
        <DockPanel Margin="18,12,18,14">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Copy to" FontWeight="Bold" VerticalAlignment="Center"
                           Margin="0,0,14,0" />
                <Button Content="All" Command="{Binding SelectAllCommand}" MinWidth="60" />
                <Button Content="None" Command="{Binding SelectNoneCommand}" MinWidth="60" Margin="6,0,0,0" />
                <Button Content="Unpaired only" Command="{Binding SelectUnpairedCommand}" Margin="6,0,0,0" />
                <Button Content="Similar in ETABS" Command="{Binding SelectSimilarCommand}" Margin="6,0,0,0"
                        ToolTip="The levels ETABS builds to the same typical floor as this one." />
            </StackPanel>

            <ListBox ItemsSource="{Binding Rows}" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,3">
                            <CheckBox IsChecked="{Binding IsChosen}" FontWeight="SemiBold">
                                <TextBlock Text="{Binding Story}" TextTrimming="CharacterEllipsis" />
                            </CheckBox>
                            <TextBlock Text="{Binding CurrentState}" TextTrimming="CharacterEllipsis"
                                       Margin="20,0,0,0" ToolTip="{Binding CurrentState}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
                                        <Setter Property="TextWrapping" Value="NoWrap" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentState}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </DockPanel>
</Window>
