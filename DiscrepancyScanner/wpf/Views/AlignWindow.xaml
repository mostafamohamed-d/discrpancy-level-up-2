<Window x:Class="DiscrepancyScanner.Wpf.AlignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Align Revit to ETABS"
        Height="720" Width="440" MinHeight="420" MinWidth="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ColorBg}">

    <!--
        Alignment in a window of its own, and a window that is not modal.

        It used to be a page of the settings window, which is shown as a dialog, and a dialog
        disables every other window belonging to the process - Revit's own window included,
        because the add-in runs on Revit's thread. So the one page whose whole job is to pick
        points in Revit was the one page that could not: the prompt appeared in Revit and no
        click ever reached it. Out here nothing is disabled, so both ways of picking work.
    -->

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Theme/Industry.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="GroupBox">
                <Setter Property="Margin" Value="0,0,0,14" />
                <Setter Property="Padding" Value="8" />
            </Style>

            <Style TargetType="CheckBox">
                <Setter Property="Margin" Value="0,2" />
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Padding" Value="4,3" />
            </Style>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#FF555555" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <!-- The way round it is meant to be done, so it is the button that looks like one. -->
            <Style x:Key="PlanPickButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>

        <!-- what just happened, and what to do next, kept in one place at the top -->
        <Border DockPanel.Dock="Top" Background="{StaticResource ColorSurface}"
                BorderBrush="{StaticResource ColorDivider}" BorderThickness="0,0,0,1"
                Padding="14,10">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap"
                       Style="{StaticResource BodyText}" />
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource ColorSurface}"
                BorderBrush="{StaticResource ColorDivider}" BorderThickness="0,1,0,0"
                Padding="14,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="CLOSE" Click="OnCloseClick"
                        MinWidth="80" Margin="6,0,0,0" />
                <Button DockPanel.Dock="Right" Content="CLEAR" Command="{Binding ResetCommand}"
                        MinWidth="80" Margin="6,0,0,0"
                        ToolTip="Drops the alignment entirely, angle included, and puts the model back where Revit draws it." />
                <Button Style="{StaticResource PrimaryButton}" Content="APPLY ALIGNMENT"
                        Command="{Binding ApplyCommand}" HorizontalAlignment="Left"
                        Margin="0" MinWidth="150"
                        ToolTip="Puts the transform in force and moves the Revit model onto it. Run the comparison again afterwards." />
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12">
            <StackPanel>

                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,10"
                           Text="Two points that are the same physical point in both models is all this needs. Pick the pair on the plan behind this window - the point on the Revit model first, then the place on the ETABS model it belongs - or pick in Revit and type the ETABS coordinate. A second pair sets the angle, and a story paired with a Revit level sets the height." />

                <GroupBox Header="Base point - sets the position">
                    <StackPanel>
                        <Button Style="{StaticResource PlanPickButton}"
                                Content="Pick the pair on the plan"
                                Command="{Binding PickBasePairOnPlanCommand}"
                                ToolTip="Two clicks on the plan: the point on the Revit model, then where it belongs on the ETABS model. Both snap to the model - ends, corners, centres, midpoints and crossings." />

                        <Button Content="or pick this point in Revit"
                                Command="{Binding PickBasePointCommand}"
                                ToolTip="Picks in the Revit window itself, with Revit's own snaps. Type the ETABS coordinate below." />

                        <TextBlock Text="{Binding RevitBasePointText, StringFormat=Revit: {0}}"
                                   Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />

                        <StackPanel IsEnabled="{Binding UsePickedTransform}">
                            <TextBlock Text="Where it lands, in ETABS coordinates (m)"
                                       Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="0,0,3,0" ToolTip="ETABS X in meters"
                                         Text="{Binding EtabsBaseX, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="1" Margin="3,0,0,0" ToolTip="ETABS Y in meters"
                                         Text="{Binding EtabsBaseY, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,3,0,0"
                                       Text="Points set the plan position only. The height comes from the story and level below." />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Rotation point - sets the heading">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,6"
                                   Text="Leave this out and the model keeps the angle it is already at. Fill it in and the angle comes from the two pairs: pick a point well away from the base point, along a direction you can recognise in both models." />

                        <Button Style="{StaticResource PlanPickButton}"
                                Content="Pick the pair on the plan"
                                Command="{Binding PickRotationPairOnPlanCommand}" />

                        <Button Content="or pick this point in Revit"
                                Command="{Binding PickRotationPointCommand}" />

                        <TextBlock Text="{Binding RevitRotationPointText, StringFormat=Revit: {0}}"
                                   Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />

                        <StackPanel IsEnabled="{Binding UsePickedTransform}">
                            <TextBlock Text="Where it lands, in ETABS coordinates (m)"
                                       Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="0,0,3,0" ToolTip="ETABS X in meters"
                                         Text="{Binding EtabsRotationX, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="1" Margin="3,0,0,0" ToolTip="ETABS Y in meters"
                                         Text="{Binding EtabsRotationY, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Height - story and level">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,6"
                                   Text="Say which Revit level an ETABS story stands for, and the height follows from the two - a picked point only has the work plane of its view to give. Use the offset when the story's slab sits above or below the level. Leave it unpaired and the height already in force is kept." />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="ETABS story" VerticalAlignment="Center"
                                       Margin="0,0,8,4" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,4"
                                      ItemsSource="{Binding Stories}" DisplayMemberPath="DisplayName"
                                      SelectedItem="{Binding SelectedStory}"
                                      ToolTip="The story in the ETABS model. Import the ETABS model to list its stories." />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Revit level" VerticalAlignment="Center"
                                       Margin="0,0,8,4" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,4"
                                      ItemsSource="{Binding RevitLevels}" DisplayMemberPath="DisplayName"
                                      SelectedItem="{Binding SelectedLevel}"
                                      ToolTip="The Revit level that stands for the story." />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Offset (mm)" VerticalAlignment="Center"
                                       Margin="0,0,8,0" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Text="{Binding LevelOffset, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Added to the level to reach the story, in millimetres - negative is below the level." />
                        </Grid>

                        <TextBlock Text="{Binding HeightSummary}" Style="{StaticResource FieldLabel}"
                                   Margin="0,6,0,4" />

                        <Button Content="Leave the height as it is" Command="{Binding ClearHeightCommand}"
                                HorizontalAlignment="Left"
                                ToolTip="Unpairs the story and level. The height already in force is kept." />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Handedness">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4"
                                   Text="Two points cannot tell a rotation from a mirror - they match either way. If the model comes out flipped, just tick this." />
                        <CheckBox Content="Revit model is mirrored" IsChecked="{Binding IsMirrored}"
                                  FontWeight="Bold" />

                        <Expander Header="or work it out from a third point" Margin="0,6,0,0">
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4"
                                           Text="A third pair, well off the line through the first two. The box above is then ticked for you, and you can still override it." />

                                <Button Style="{StaticResource PlanPickButton}"
                                        Content="Pick the pair on the plan"
                                        Command="{Binding PickMirrorPairOnPlanCommand}" />

                                <Button Content="or pick this point in Revit"
                                        Command="{Binding PickMirrorPointCommand}" />

                                <TextBlock Text="{Binding RevitMirrorPointText, StringFormat=Revit: {0}}"
                                           Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />

                                <StackPanel IsEnabled="{Binding UsePickedTransform}">
                                    <TextBlock Text="Where it lands, in ETABS coordinates (m)"
                                               Style="{StaticResource FieldLabel}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Margin="0,0,3,0" ToolTip="ETABS X in meters"
                                                 Text="{Binding EtabsMirrorX, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Column="1" Margin="3,0,0,0" ToolTip="ETABS Y in meters"
                                                 Text="{Binding EtabsMirrorY, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </StackPanel>

                                <TextBlock Text="{Binding MirrorDetection}" Style="{StaticResource FieldLabel}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Or type the move in">
                    <StackPanel>
                        <CheckBox Content="Set the angle and displacement by hand"
                                  IsChecked="{Binding UseTypedTransform}" FontWeight="Bold" />
                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,4,0,6"
                                   Text="The Revit model is turned about its own origin by the angle, then moved by the displacement - so the displacement is where it lands after it has been turned. The height still comes from the story and level above. Ticking this carries the picked alignment across, so you can start from what the points gave and adjust it. Picking anything switches back." />

                        <Grid IsEnabled="{Binding UseTypedTransform}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Angle (deg)" VerticalAlignment="Center"
                                       Margin="0,0,6,0" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" ToolTip="Counter clockwise about the Revit model origin, in degrees."
                                     Text="{Binding TypedRotation, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <TextBlock Text="Displacement (m)" Style="{StaticResource FieldLabel}"
                                   Margin="0,6,0,2" IsEnabled="{Binding UseTypedTransform}" />
                        <Grid IsEnabled="{Binding UseTypedTransform}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Margin="0,0,3,0" ToolTip="dX in meters"
                                     Text="{Binding TypedDx, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Column="1" Margin="3,0,0,0" ToolTip="dY in meters"
                                     Text="{Binding TypedDy, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <TextBlock Text="What this would do" FontWeight="Bold" Margin="0,4,0,3" />
                <TextBlock Text="{Binding Preview}" Style="{StaticResource FieldLabel}"
                           Margin="0,0,0,8" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
