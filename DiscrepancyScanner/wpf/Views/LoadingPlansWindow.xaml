<Window x:Class="DiscrepancyScanner.Wpf.LoadingPlansWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Loading plans"
        Height="680" Width="1000" MinHeight="460" MinWidth="780"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ColorBg}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Theme/Industry.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="ShowWhenTrue" />

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF555555" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="MinWidth" Value="86" />
        </Style>

        <!--
            One level. The dot carries the verdict, the same three colours the plan is drawn
            in, so a table of twenty levels is read at a glance rather than one row at a time.
        -->
        <DataTemplate x:Key="LevelRow">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0" Width="9" Height="9" Fill="{Binding Swatch}"
                         VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,4,0,0" />

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Story}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />

                    <!--
                        The two lines under the level say what it is paired with, and take no
                        room at all on a level that is paired with nothing - otherwise every
                        unpaired row is three lines tall to say one word.
                    -->
                    <TextBlock Text="{Binding ViewName}" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ViewName}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{Binding SheetName}" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
                                <Setter Property="Foreground" Value="#FF888888" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SheetName}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{Binding LineSheetName}" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
                                <Setter Property="Foreground" Value="#FF888888" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LineSheetName}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding StatusText}" Margin="8,0,0,0"
                           VerticalAlignment="Top" FontSize="11" Foreground="#FF666666" />
            </Grid>
        </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>

        <!-- what this window is for -->
        <Border DockPanel.Dock="Top" Background="{StaticResource ColorBg}" Padding="18,12"
                BorderBrush="{StaticResource ColorBorder}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="LOADING PLANS" Style="{StaticResource BrandText}" />
                <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                           Text="One row per ETABS level. Say which Revit view carries the loading plan and which sheet its numbers are on. A level you leave alone is still checked for thickness and outline - pairing six out of forty-seven is a sensible day&apos;s work, not a half-finished job." />

                <!--
                    A count per state rather than one sentence: the four say different things.
                    Ready is done, a missing view is broken, a missing sheet is half done, and
                    unpaired is work not started - which on a tall building is the normal
                    condition and not a fault.
                -->
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,22,0">
                        <TextBlock Text="{Binding ReadyCount}" Style="{StaticResource HeadingText}"
                                   Foreground="{StaticResource VerdictPassed}" />
                        <TextBlock Text="ready" Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Bottom" Margin="6,0,0,3" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,22,0"
                                Visibility="{Binding HasNoSchedule, Converter={StaticResource ShowWhenTrue}}">
                        <TextBlock Text="{Binding NoScheduleCount}" Style="{StaticResource HeadingText}"
                                   Foreground="{StaticResource VerdictReview}" />
                        <TextBlock Text="need a sheet" Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Bottom" Margin="6,0,0,3" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,22,0"
                                Visibility="{Binding HasViewMissing, Converter={StaticResource ShowWhenTrue}}">
                        <TextBlock Text="{Binding ViewMissingCount}" Style="{StaticResource HeadingText}"
                                   Foreground="{StaticResource VerdictFailed}" />
                        <TextBlock Text="view is gone" Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Bottom" Margin="6,0,0,3" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding UnpairedCount}" Style="{StaticResource HeadingText}"
                                   Foreground="{StaticResource ColorNeutral600}" />
                        <TextBlock Text="not paired" Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Bottom" Margin="6,0,0,3" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- the way out, and the count -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource ColorSurface}" Padding="18,10"
                BorderBrush="#FFCCCCCC" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="DONE" IsDefault="True" IsCancel="True"
                        Style="{StaticResource PrimaryButton}"
                        Click="OnDoneClick" FontWeight="SemiBold" />
                <!--
                    The guess has a window of its own: which levels, what a loading plan view
                    is called, and which sheets they read, with every guess shown before it is
                    made.
                -->
                <Button DockPanel.Dock="Right" Content="LOAD PATTERNS..." Margin="0,0,10,0" MinWidth="150"
                        Command="{Binding LoadPatternsCommand}"
                        ToolTip="Which ETABS load pattern is which load of the loading plan, and what the Excel schedule calls SIDL, live load and the rest." />
                <Button DockPanel.Dock="Right" Content="GUESS BY NAME..." Margin="0,0,10,0"
                        MinWidth="160" Command="{Binding GuessCommand}"
                        ToolTip="{Binding GuessSummary}" />
                <TextBlock Text="{Binding Summary}" VerticalAlignment="Center"
                           TextWrapping="Wrap" Margin="0,0,12,0" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="220" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- left: every level, and where each one has got to -->
            <DockPanel Grid.Column="0" Margin="18,14,0,14">
                <TextBlock DockPanel.Dock="Top" Text="ETABS levels" FontWeight="Bold"
                           Margin="0,0,0,6" />

                <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Rows}"
                         SelectedItem="{Binding SelectedRow}"
                         ItemTemplate="{StaticResource LevelRow}"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Visibility="{Binding HasStories, Converter={StaticResource ShowWhenTrue}}" />

                <TextBlock Text="No ETABS levels yet. Import the ETABS model first - its levels are what a loading plan is paired with."
                           Style="{StaticResource FieldLabel}" VerticalAlignment="Top"
                           Visibility="{Binding HasNoStories, Converter={StaticResource ShowWhenTrue}}" />
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="#FFEAEAEA" />

            <!-- right: the pairing for whichever level is selected -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="18,14,18,14">
                <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource ShowWhenTrue}}">

                    <TextBlock Text="{Binding EditorHeading}" FontSize="14" FontWeight="Bold"
                               TextWrapping="Wrap" Margin="0,0,0,14" />

                    <!-- the view, found by typing rather than by scrolling -->
                    <TextBlock Text="Loading plan view" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,6"
                               Text="The Revit plan view the filled regions of the loading plan are drawn in. Drafting views are not listed: their coordinates are not the model's, so a plan drawn in one would not land on the slab." />

                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="Clear" MinWidth="60" Margin="6,0,0,0"
                                Command="{Binding ClearSearchCommand}" />
                        <TextBox x:Name="searchBox" Padding="4,3"
                                 Text="{Binding ViewSearch, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Type any part of the view name. Every word has to appear, in any order. Separate with commas - TOWER A, SDL - and every phrase has to appear instead, ignoring case, spaces, dashes and underscores." />
                    </DockPanel>

                    <ListBox ItemsSource="{Binding Views}" SelectedItem="{Binding SelectedView}"
                             DisplayMemberPath="DisplayName" Height="150"
                             HorizontalContentAlignment="Stretch" />

                    <TextBlock Text="{Binding ViewCountText}" Style="{StaticResource FieldLabel}"
                               Margin="0,4,0,16" />

                    <!-- the schedule -->
                    <TextBlock Text="Loading schedule" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,6"
                               Text="The workbook carries over from the levels already paired, because a project has one. The sheet does not: numbering starts again on every sheet, so a tower sheet and a podium sheet both begin at 1 and picking the wrong one is silently wrong." />

                    <Button Content="Import loading schedule..." HorizontalAlignment="Left"
                            Command="{Binding PickWorkbookCommand}" />
                    <TextBlock Text="{Binding WorkbookName}" Style="{StaticResource FieldLabel}"
                               Margin="0,4,0,8" TextTrimming="CharacterEllipsis" />

                    <TextBlock Text="Area load sheet" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="View / edit..." Margin="6,0,0,0" MinWidth="100"
                                Command="{Binding ViewAreaSheetCommand}"
                                ToolTip="See this sheet as the check reads it, and change it - into the workbook, or in the tool only." />
                        <ComboBox ItemsSource="{Binding ScheduleSheets}"
                                  SelectedItem="{Binding SelectedScheduleSheet}" />
                    </DockPanel>

                    <!--
                        A second tab of the same workbook, because that is how these schedules
                        are kept: one file per project, a tab per part of the building for the
                        area loads and a tab per part for the line loads. Left empty is a level
                        whose line loads are not checked, which is not a half finished pairing -
                        the two checks are set up separately and either stands on its own.
                    -->
                    <TextBlock Text="Line load sheet" Style="{StaticResource FieldLabel}" Margin="0,10,0,3" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="View / edit..." Margin="6,0,0,0" MinWidth="100"
                                Command="{Binding ViewLineSheetCommand}"
                                ToolTip="See this sheet as the check reads it, and change it - into the workbook, or in the tool only." />
                        <ComboBox ItemsSource="{Binding ScheduleSheets}"
                                  SelectedItem="{Binding SelectedLineLoadSheet}"
                                  ToolTip="The tab the line loads are on. Leave it empty to check this level's area loads only." />
                    </DockPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <!--
                            A typical floor is one plan read by a run of levels: pair it once
                            here, then give the same view and sheets to the rest.
                        -->
                        <Button Content="Copy to levels..." Command="{Binding CopyToCommand}" MinWidth="130"
                                ToolTip="Give this level's view, workbook and sheets to other levels - a typical floor's loading plan to every level built to it." />
                        <Button Content="Unpair this level" Command="{Binding UnpairCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
